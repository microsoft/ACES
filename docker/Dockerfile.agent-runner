# SABER Agent Runner Base Image
#
# Provides Python runtime with standard MCP libraries for agent execution.
# Designed for secure, isolated agent execution with standard MCP compatibility.

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Install lightweight MCP libraries and agent dependencies
RUN pip install --no-cache-dir \
    httpx \
    aiohttp \
    pydantic \
    pyyaml \
    anthropic \
    openai \
    requests \
    # Basic agent framework dependencies only
    asyncio-mqtt \
    websockets

# Create non-root user for security
RUN groupadd -r agent && useradd -r -g agent -d /app -s /bin/bash agent

# Copy SABER client runtime
COPY src/saber/client/agent_runtime /agent_runtime/saber/client/agent_runtime
COPY src/saber/__init__.py /agent_runtime/saber/__init__.py
COPY src/saber/base.py /agent_runtime/saber/base.py

# Create necessary directories
RUN mkdir -p /app/agent /app/runtime /tmp /var/tmp && \
    chown -R agent:agent /app /tmp /var/tmp /agent_runtime

# Set security configurations
RUN chmod 755 /app && \
    chmod 1777 /tmp /var/tmp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Switch to non-root user
USER agent

# Set environment variables
ENV PYTHONPATH="/app:/app/agent:/app/runtime:/agent_runtime"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Default command (will be overridden by container execution)
CMD ["/bin/bash"]
