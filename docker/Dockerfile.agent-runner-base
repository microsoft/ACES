# SABER Agent Runner Base Image (Lightweight)
#
# Core Python runtime with standard MCP libraries for agent execution.
# No heavy dependencies - suitable for CLI/API-based agents.

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Install core MCP libraries and common dependencies
RUN pip install --no-cache-dir \
    fastapi \
    httpx \
    aiohttp \
    pydantic \
    pyyaml \
    anthropic \
    openai \
    requests \
    beautifulsoup4 \
    lxml

# Create non-root user for security
RUN groupadd -r agent && useradd -r -g agent -d /app -s /bin/bash agent

# Create necessary directories
RUN mkdir -p /app/agent /app/runtime /tmp /var/tmp && \
    chown -R agent:agent /app /tmp /var/tmp

# Set security configurations
RUN chmod 755 /app && \
    chmod 1777 /tmp /var/tmp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Switch to non-root user
USER agent

# Set environment variables
ENV PYTHONPATH="/app:/app/agent:/app/runtime"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Default command (will be overridden by container execution)
CMD ["/bin/bash"]
