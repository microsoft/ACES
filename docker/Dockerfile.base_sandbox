FROM ubuntu:22.04

# Install essential security tools
RUN apt-get update && apt-get install -y \
    file \
    binutils \
    bsdmainutils \
    python3 \
    python3-pip \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd --gid 1000 tooluser && \
    useradd --uid 1000 --gid tooluser --shell /bin/bash --create-home tooluser

# Set up workspace
WORKDIR /workspace
RUN chown tooluser:tooluser /workspace

USER tooluser

# Security: Container runs as non-root, with limited capabilities
