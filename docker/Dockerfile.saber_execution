# Enhanced SABER Execution Environment
# This file provides a common execution base with security testing tools
FROM ubuntu:22.04

# Install system dependencies and penetration testing tools
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    netcat \
    nmap \
    dirb \
    nikto \
    python3 \
    python3-pip \
    python3-requests \
    git \
    vim \
    jq \
    net-tools \
    iproute2 \
    iputils-ping \
    dnsutils \
    file \
    binutils \
    bsdmainutils \
    && rm -rf /var/lib/apt/lists/*

# Install common Python packages for security analysis
RUN pip3 install --no-cache-dir \
    requests \
    beautifulsoup4 \
    urllib3 \
    lxml \
    python-nmap \
    paramiko

# Create workspace directory
WORKDIR /workspace

# Create non-root user for security
RUN groupadd --gid 1000 saber && \
    useradd --uid 1000 --gid saber --shell /bin/bash --create-home saber && \
    chown saber:saber /workspace

# Set environment variables
ENV PYTHONPATH=/workspace
ENV PYTHONUNBUFFERED=1

USER saber

# Keep container running
CMD ["tail", "-f", "/dev/null"]
