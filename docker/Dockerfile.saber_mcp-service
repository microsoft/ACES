# MCP Service Container
# Provides shared MCP protocol access for containerized agents

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies directly (using project dependencies)
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    httpx \
    aiohttp \
    pydantic \
    pyyaml \
    fastmcp

# Copy only the necessary MCP service files and dependencies
COPY src/saber/__init__.py ./saber/__init__.py
COPY src/saber/base.py ./saber/base.py
COPY src/saber/client/mcp_service/ ./saber/client/mcp_service/

# Create minimal client package structure
RUN mkdir -p ./saber/client && \
    echo "" > ./saber/client/__init__.py

# Set Python path
ENV PYTHONPATH=/app

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash --uid 1000 mcpservice
USER mcpservice

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Expose MCP service port
EXPOSE 8002

# Default command for MCP service
CMD ["python", "-m", "saber.client.mcp_service.standalone"]
