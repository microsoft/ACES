# Generic SABER Server Base Image
# This file provides a common base for all SABER domain servers
#
# CI Build (ADO Pipeline): Uses System.AccessToken via --secret
# Local Build (with az login):
#   DOCKER_BUILDKIT=1 docker build --secret id=ADO_TOKEN,env=ADO_TOKEN -f docker/Dockerfile.saber_server -t saber/server:latest .
#   (run with: ADO_TOKEN=$(az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 -q accessToken -o tsv) before the command)
#
FROM python:3.11-slim

# Install system dependencies for Docker-in-Docker and networking
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for Docker-in-Docker execution)
RUN curl -fsSL https://get.docker.com | sh

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set working directory
WORKDIR /app

# Copy dependency files and source code
COPY pyproject.toml uv.lock ./
COPY src ./src

# Install dependencies using uv
# Uses secret mount for ADO git authentication (System.AccessToken in CI)
RUN --mount=type=secret,id=ADO_TOKEN,required=false \
    TOKEN="$(cat /run/secrets/ADO_TOKEN 2>/dev/null || echo '')" && \
    if [ -n "$TOKEN" ]; then \
        git config --global url."https://${TOKEN}@dev.azure.com".insteadOf "https://MSECAIModels@dev.azure.com"; \
    fi && \
    uv pip install --system --no-cache -e . && \
    git config --global --unset-all url.https://*@dev.azure.com.insteadOf 2>/dev/null || true

# Create standard directories
RUN mkdir -p /app/config /app/data /app/logs

# Set standard environment variables
ENV PYTHONPATH=/app/src

# Expose standard SABER ports
EXPOSE 8000 8001

# Default command - can be overridden by domain-specific Dockerfiles
CMD ["python", "-m", "saber.server", "--start"]
