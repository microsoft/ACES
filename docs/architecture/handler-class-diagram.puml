@startuml Task Handler Class Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam handwritten false
skinparam defaultFontName Arial

title Task Handler Architecture\n(Polymorphic Episode Lifecycle Management)

package "saber.models" {
  abstract class BenchmarkTask {
    +task_type: str
    +benchmark_task_id: str
    +execution_mode: TaskExecutionMode
    +episode_attempts: int
    --
    {abstract} +get_task_ids(): List[str]
    {abstract} +get_total_episodes(): int
    {abstract} +matches_filter(pattern: str): bool
  }

  class SingleEpisodeTask {
    +task_type: "single"
    +task_id: str
    +domain: str
    +title: str
    +description: str
    +subtask_count: int
    +max_steps: int
    +initial_context: Optional[Dict]
    +instruction_prompt: str
    +assistant_prompt: str
    +submit_prompt: str
    +continue_prompt: str
    +transcript_config: Optional[Dict]
    --
    +get_task_ids(): List[str]
    +get_total_episodes(): int
    +matches_filter(pattern): bool
  }

  class OrchestratedTask {
    +task_type: "orchestrated"
    +orchestration_strategy: OrchestrationStrategy
    +sub_tasks: List[SubTaskDefinition]
    +orchestration_config: Dict
    --
    +get_task_ids(): List[str]
    +get_total_episodes(): int
    +matches_filter(pattern): bool
  }

  class SubTaskDefinition {
    +task_id: str
    +role: Optional[str]
    +order: int
    +depends_on_role: Optional[str]
    +domain: str
    +title: str
    +description: str
    +episode_attempts: int
    +subtask_count: int
    +max_steps: int
    +instruction_prompt: str
    +assistant_prompt: str
    +submit_prompt: str
    +continue_prompt: str
    +transcript_config: Optional[Dict]
  }

  enum TaskExecutionMode {
    SINGLE
    ORCHESTRATED
  }

  enum OrchestrationStrategy {
    SEQUENTIAL_PAIRED
    PARALLEL
    CONDITIONAL
  }
}

package "saber.inspect_ai.core.types" {
  class HandlerState <<dataclass>> {
    +episode_ids: List[str]
    +primary_episode_id: str
    +semaphore_acquired: bool
    --
    +has_multiple_episodes(): bool
    +to_dict(): Dict[str, Any]
  }

  class OrchestratedHandlerState <<dataclass>> {
    +episodes: List[Dict[str, Any]]
    --
    +get_episode_by_role(role): Optional[Dict]
    +to_dict(): Dict[str, Any]
  }

  HandlerState <|-- OrchestratedHandlerState
}

package "saber.inspect_ai.core.task_handlers" {
  abstract class BenchmarkTaskHandler {
    #_semaphore_acquired: bool
    #_acquired_semaphore_ref: Optional[Semaphore]
    #_cleanup_error_count: int
    #_cleanup_lock: asyncio.Lock
    --
    +__del__(): None
    {abstract} +initialize(task, session_id, session_manager, semaphore): HandlerState
    {abstract} +cleanup(state, session_id, session_manager, semaphore): CleanupResult
  }

  class SingleEpisodeTaskHandler {
    --
    +initialize(task, session_id, session_manager, semaphore): HandlerState
    +cleanup(state, session_id, session_manager, semaphore): CleanupResult
  }

  class OrchestratedTaskHandler {
    --
    +initialize(task, session_id, session_manager, semaphore): OrchestratedHandlerState
    +cleanup(state, session_id, session_manager, semaphore): CleanupResult
  }

  class CleanupResult <<dataclass>> {
    +success: bool
    +error_count: int
    +errors: List[str]
    +semaphore_released: bool
    +threshold_exceeded: bool
    --
    +has_errors: bool @property
  }

  class "get_benchmark_task_handler()" as Factory {
    +get_benchmark_task_handler(task: BenchmarkTask): BenchmarkTaskHandler
  }
}

' Relationships
BenchmarkTask <|-- SingleEpisodeTask
BenchmarkTask <|-- OrchestratedTask
OrchestratedTask *-- "1..*" SubTaskDefinition : contains
BenchmarkTask ..> TaskExecutionMode : uses
OrchestratedTask ..> OrchestrationStrategy : uses

BenchmarkTaskHandler <|-- SingleEpisodeTaskHandler
BenchmarkTaskHandler <|-- OrchestratedTaskHandler
BenchmarkTaskHandler ..> CleanupResult : returns
SingleEpisodeTaskHandler ..> HandlerState : returns
OrchestratedTaskHandler ..> OrchestratedHandlerState : returns
Factory ..> BenchmarkTaskHandler : creates
Factory ..> SingleEpisodeTask : inspects
Factory ..> OrchestratedTask : inspects

note right of BenchmarkTaskHandler::__del__
  **Semaphore Leak Detection**
  Logs error "SEMAPHORE LEAK DETECTED"
  if handler destroyed without cleanup().
  Semaphore slot is permanently lost.
end note

note bottom of SingleEpisodeTaskHandler
  **Handles 1 Episode:**
  - Acquire semaphore
  - Create episode
  - Wait for ready
  - (Agent executes externally)
  - End episode
  - Release semaphore
end note

note bottom of OrchestratedTaskHandler
  **Handles N Episodes (1 Semaphore):**
  - Acquire ONE semaphore slot
  - Create episodes sequentially
    (dependency order)
  - Wait for each to be ready
  - (Agents execute externally)
  - End all episodes
  - Release ONE semaphore slot
end note

note top of Factory
  **Polymorphic Dispatch:**
  isinstance(task, SingleEpisodeTask)
    → SingleEpisodeTaskHandler
  isinstance(task, OrchestratedTask)
    → OrchestratedTaskHandler
end note

@enduml
