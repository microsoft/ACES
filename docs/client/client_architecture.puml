@startuml SABER Client Architecture - Current Implementation

!theme plain
title SABER Client Architecture - Current Implementation

skinparam class {
    BackgroundColor lightblue
    BorderColor black
    ArrowColor black
    FontSize 10
}

skinparam component {
    BackgroundColor lightgreen
    BorderColor black
    FontSize 10
}

package "SABER Client Infrastructure" {

    class SABEREvaluationOrchestrator {
        +config: SABERConfig
        +agent_manager: Optional[AgentManager]
        +dataset_manager: Optional[DatasetManager]
        +session_manager: Optional[ClientSessionManager]
        +_initialized: bool
        --
        +__aenter__(): SABEREvaluationOrchestrator
        +__aexit__(): void
        +execute(): EvalLog
        +_validate_config(): void
        --
        **Async Context Management**
        +_ensure_components_initialized(): void
        +_cleanup_components(): void
    }

    class AgentManager {
        +config: SABERConfig
        +session_manager: ClientSessionManager
        +agent_registry: SABERAgentRegistry
        +_initialized: bool
        --
        +create_tasks(): List[Task]
        +__aenter__(): AgentManager
        +__aexit__(): void
        --
        **Agent Integration**
        +_resolve_agent_for_task(): Agent
        +_create_inspect_ai_tasks(): List[Task]
    }

    class DatasetManager {
        +config: SABERConfig
        +session_manager: ClientSessionManager
        +benchmark_info: Optional[BenchmarkInfo]
        +task_dataset: Optional[List[Sample]]
        +_initialized: bool
        --
        +create_dataset(): List[Sample]
        +__aenter__(): DatasetManager
        +__aexit__(): void
        --
        **Dataset Creation**
        +_fetch_benchmark_info(): BenchmarkInfo
        +_create_task_samples(): List[Sample]
    }

    class ClientSessionManager {
        +config: SessionManagerConfig
        +base_url: str
        +client_id: str
        +timeout: float
        +_current_session_id: Optional[str]
        --
        +create_session(): str
        +terminate_session(): bool
        +get_tasks(): List[TaskInfo]
        +create_episode(): EpisodeCreateResponse
        +get_policy_response(): PolicyResponse
        +__aenter__(): ClientSessionManager
        +__aexit__(): void
        --
        **Session Lifecycle**
        +_make_request(): Dict[str, Any]
        +_handle_response(): Any
    }

    package "API Client Layer" {
        class SABERRestClient {
            +saber_server_url: str
            +client_id: str
            +request_timeout: aiohttp.ClientTimeout
            --
            +get_benchmark_info(): BenchmarkInfo
            +create_session(): str
            +create_episode(): EpisodeCreateResponse
            +terminate_session(): bool
            +get_task_info(): TaskInfo
            +get_policy_info(): PolicyResponse
            +health_check(): Dict[str, Any]
            --
            **HTTP Operations**
            +_make_request(): Dict[str, Any]
            +_handle_response(): Any
        }
    }

    package "Agent System" {
        class SABERAgentRegistry {
            +_agents: Dict[str, Any]
            --
            +register_agent(): void
            +get_agent(): Agent
            +list_agents(): List[str]
            --
            **Agent Discovery**
            +_discover_agents(): void
        }

        class SABERAgentFactory {
            +registry: SABERAgentRegistry
            --
            +create_agent(): Agent
            +get_available_agents(): List[str]
            --
            **Agent Creation**
            +_resolve_agent_type(): str
            +_create_agent_instance(): Agent
        }
    }

    package "Inspect AI Integration" {
        class saber_dataset {
            --
            **Dataset Factory Function**
            +create_saber_dataset(): Dataset
            --
            **Features**
            - Creates inspect_ai.Sample from TaskInfo
            - Adds SABER metadata to samples
            - Type-safe task conversion
        }

        class saber_agent {
            --
            **Agent Factory Function**
            +saber_agent(): Agent
            --
            **SABER Integration**
            - Uses mcp_server_http() for tools
            - Dynamic policy fetching
            - Session and episode management
        }

        class saber_scorer {
            --
            **Scorer Factory Function**
            +saber_scorer(): Scorer
            --
            **Scoring Logic**
            - Integration with SABER server evaluation
            - Custom scoring for security tasks
            - Results persistence
        }

        class run_saber_eval_async {
            --
            **Main Entry Point**
            +run_saber_eval_async(): EvalLog
            --
            **Features**
            - eval_async compatible interface
            - Uses SABEREvaluationOrchestrator
            - Automatic resource management
        }
    }

    package "Configuration and Models" {
        class SABERConfig {
            +agent_assignments: List[AgentAssignment]
            +server_url: str = "http://localhost:8000"
            +mcp_server_url: str = "http://localhost:8001"
            +task_ids: Optional[List[str]]
            +log_level: str = "INFO"
            +max_steps: int = 50
            +log_dir: Optional[str]
            +session_log_dir: Optional[str]
            --
            **Validation**
            +validate(): void
            +to_session_config(): SessionManagerConfig
        }

        class SessionManagerConfig {
            +base_url: str
            +client_id: str = "saber_client"
            +rest_timeout: float = 30.0
            +mcp_server_url: str
            --
            **Factory Methods**
            +from_urls(): SessionManagerConfig
        }

        class AgentAssignment {
            +agent_id: str
            +task_ids: Optional[List[str]]
            +agent_kwargs: Dict[str, Any]
            --
            **Task Assignment**
            +applies_to_task(): bool
        }
    }

    class CLI {
        --
        +main(): void
        +setup_client_logging(): void
        +_parse_arguments(): argparse.Namespace
        +_run_evaluation(): EvalLog
    }
}

' Core Relationships
SABEREvaluationOrchestrator *-- AgentManager
SABEREvaluationOrchestrator *-- DatasetManager
SABEREvaluationOrchestrator *-- ClientSessionManager
AgentManager *-- SABERAgentRegistry
AgentManager ..> SABERAgentFactory : uses
ClientSessionManager ..> SABERRestClient : uses

' Inspect AI Integration
run_saber_eval_async ..> SABEREvaluationOrchestrator : orchestrates
saber_dataset ..> ClientSessionManager : fetches tasks
saber_agent ..> ClientSessionManager : gets policy/context
saber_scorer ..> ClientSessionManager : evaluation

' Configuration
SABEREvaluationOrchestrator ..> SABERConfig : uses
SABERConfig *-- AgentAssignment
SABERConfig ..> SessionManagerConfig : converts to
ClientSessionManager ..> SessionManagerConfig : uses

' CLI orchestration
CLI ..> run_saber_eval_async : calls

' External communication
SABERRestClient ..> "SABER Server" : "HTTP REST API"
saber_agent ..> "SABER Server" : "MCP via mcp_server_http()"

note top of SABEREvaluationOrchestrator
**SABER Evaluation Orchestrator - Main Entry Point**
- Async context manager for proper resource management
- Upfront configuration validation with fail-fast design
- Component lifecycle management (Agent, Dataset, Session managers)
- BREAKING CHANGE: No backwards compatibility with old patterns
- Uses inspect_ai framework for agent evaluation
end note

note right of ClientSessionManager
**Session Management - REST API Only**
- Pure aiohttp REST client (no MCP client management)
- Session creation and episode management
- Policy and task information retrieval
- Automatic session cleanup on exit
- MCP handled by inspect_ai's mcp_server_http()
end note

note left of saber_agent
**Inspect AI Native MCP Integration**
- Uses inspect_ai's mcp_server_http() for tools
- Dynamic policy fetching from SABER server
- Session and episode context management
- No custom MCP client needed
end note

note bottom of SABERConfig
**Configuration Model**
- Agent assignment based configuration
- Support for multiple agents per evaluation
- Environment variable support
- Conversion to component-specific configs
- Fail-fast validation on initialization
end note

@enduml
