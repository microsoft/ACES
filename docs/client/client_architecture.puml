package "SABER Client Infrastructure - Current Implementation" {

    class SABEREvaluationOrchestrator {
        +config: SABERConfig
        +agent_manager: Optional[AgentManager]
        +dataset_manager: Optional[DatasetManager]
        +session_manager: Optional[ClientSessionManager]
        +_initialized: bool
        --
        +__aenter__(): SABEREvaluationOrchestrator
        +__aexit__(): void
        +execute(): EvalLog
        +_validate_config(): void
        --
        **Async Context Management**
        +_ensure_components_initialized(): void
        +_cleanup_components(): void
    }

    class AgentManager {
        +config: SABERConfig
        +session_manager: ClientSessionManager
        +saber_agent: Optional[AgentInfo]
        +_initialized: bool
        --
        +create_tasks(): List[Task]
        +__aenter__(): AgentManager
        +__aexit__(): void
        --
        **Agent Integration**
        +_initialize_agent(): AgentInfo
        +_create_inspect_ai_tasks(): List[Task]
    }

    class DatasetManager {
        +config: SABERConfig
        +session_manager: ClientSessionManager
        +benchmark_info: Optional[BenchmarkInfo]
        +task_dataset: Optional[List[Sample]]
        +_initialized: bool
        --
        +create_dataset(): List[Sample]
        +__aenter__(): DatasetManager
        +__aexit__(): void
        --
        **Dataset Creation**
        +_fetch_benchmark_info(): BenchmarkInfo
        +_create_task_samples(): List[Sample]
    }

    class ClientSessionManager {
        +config: SessionManagerConfig
        +rest_client: Optional[SABERRestClient]
        +mcp_client: Optional[SABERMCPClient]
        +session_id: Optional[str]
        +_session_created: bool
        --
        +create_session(): str
        +cleanup_session(): void
        +get_benchmark_info(): BenchmarkInfo
        +create_episode(): EpisodeCreateResponse
        +get_policy_response(): PolicyResponse
        +ensure_episode_mcp_client(): SABERMCPClient
        +__aenter__(): ClientSessionManager
        +__aexit__(): void
        --
        **Session Lifecycle**
        +_create_rest_client(): SABERRestClient
        +_cleanup_clients(): void
    }

    package "HTTP Client Layer" {
        class SABERRestClient {
            +base_url: str
            +client_id: str
            +session: ClientSession
            --
            +create_session(): str
            +get_benchmark(): Dict[str, Any]
            +start_episode(task_id: str): str
            +get_task_info(): Dict[str, Any]
            +get_policy_info(): Dict[str, Any]
            +list_tasks(): List[Dict[str, Any]]
            +terminate_session(): bool
            +health_check(): Dict[str, Any]
            --
            **HTTP Operations**
            +_make_request(): Dict[str, Any]
            +_handle_response(): Any
        }

        class SABERMCPClient {
            +session_id: str
            +episode_id: str
            +base_url: str
            +client_session: ClientSession
            --
            +list_tools(): List[MCPToolSchema]
            +call_tool(request: MCPToolCallRequest): Any
            +close(): void
            --
            **MCP Operations**
            +_make_mcp_request(): Any
            +_handle_mcp_response(): Any
        }
    }

    package "Inspect AI Integration" {
        class SABERDataset {
            +samples: List[Sample]
            +metadata: Dict[str, Any]
            --
            +from_benchmark_info(): SABERDataset
            +to_inspect_ai_dataset(): Dataset
            --
            **Sample Creation**
            +_create_sample_from_task(): Sample
            +_add_task_metadata(): Dict[str, Any]
        }

        class SABERReactAgent {
            +attempts: int = 1
            +agent_id: str = "saber_react"
            +session_manager: Optional[ClientSessionManager]
            --
            +saber_react(): Agent
            +saber_enhanced_agent(): AgentState
            --
            **SABER Integration**
            +_initialize_saber_context(): void
            +_get_saber_tools(): List[Tool]
            +_execute_with_mcp(): AgentState
        }

        class SABERTaskScorer {
            +session_manager: ClientSessionManager
            +episode_context: Dict[str, Any]
            --
            +score(): Score
            +server_scorer(): Scorer
            +task_scorer(): Scorer
            --
            **Scoring Logic**
            +_evaluate_task_completion(): float
            +_get_episode_results(): Dict[str, Any]
        }
    }

    package "Configuration and Models" {
        class SABERConfig {
            +agent_id: str
            +server_url: str = "http://localhost:8000"
            +mcp_url: str = "http://localhost:3001"
            +task_ids: Optional[List[str]]
            +log_level: str = "INFO"
            +max_steps: int = 50
            --
            **Validation**
            +validate_config(): void
            +to_session_config(): SessionManagerConfig
        }

        class SessionManagerConfig {
            +server_url: str
            +mcp_url: str
            +client_id: str
            +timeout_seconds: int = 300
            --
            +from_saber_config(): SessionManagerConfig
        }
    }

    class CLI {
        --
        +main(): void
        +setup_client_logging(): void
        +_parse_arguments(): argparse.Namespace
        +_run_evaluation(): EvalLog
    }
}

' Core Relationships
SABEREvaluationOrchestrator *-- AgentManager
SABEREvaluationOrchestrator *-- DatasetManager
SABEREvaluationOrchestrator *-- ClientSessionManager
ClientSessionManager *-- SABERRestClient
ClientSessionManager ..> SABERMCPClient : creates per episode

' Inspect AI Integration
AgentManager ..> SABERReactAgent : creates
DatasetManager ..> SABERDataset : creates
SABERTaskScorer ..> ClientSessionManager : uses

' Configuration
SABEREvaluationOrchestrator ..> SABERConfig : uses
ClientSessionManager ..> SessionManagerConfig : uses

' CLI orchestration
CLI ..> SABEREvaluationOrchestrator : orchestrates

' External communication
SABERRestClient ..> "SABER Server" : "HTTP REST API"
SABERMCPClient ..> "SABER Server" : "MCP Protocol"

note top of SABEREvaluationOrchestrator
**SABER Evaluation Orchestrator - Main Entry Point**
- Replaces function-based eval_async approach
- Async context manager for proper resource management
- Upfront configuration validation with fail-fast design
- Component lifecycle management (Agent, Dataset, Session managers)
- BREAKING CHANGE: No backwards compatibility with old patterns
- Uses inspect_ai framework for agent evaluation
end note

note right of ClientSessionManager
**Session Management - HTTP Based**
- Manages REST and MCP client lifecycle
- Per-episode MCP client creation
- Automatic session cleanup on exit
- Supports dynamic policy fetching
- Fail-fast error handling with structured exceptions
end note

note left of SABERReactAgent
**Inspect AI Agent Integration**
- Uses @agent decorator for proper registration
- Enhanced with SABER infrastructure
- MCP tool discovery and integration
- Dynamic prompt fetching from policy endpoint
- Session and context management via inspect_ai store
end note

note bottom of SABERConfig
**Configuration Model**
- Pydantic-based validation
- Environment variable support
- Conversion to component-specific configs
- Fail-fast validation on initialization
end note

