    package "Core Orchestration Layer" {
        class SABEREvaluationOrchestrator {
            +config: SABERConfig
            +session_manager: ClientSessionManager
            +agent_manager: AgentManager
            +dataset_manager: DatasetManager
            --
            **Async Context Manager**
            +__aenter__(): validates_and_initializes_all_components
            +__aexit__(): guaranteed_cleanup
            +execute(): EvalLog
            --
            **Upfront Validation**
            +_validate_configuration(): fail_fast_validation
            +_test_server_connectivity(): early_failure_detection
            --
            **Responsibilities**
            - Component lifecycle management
            - Resource management and cleanup
            - Error handling and recovery
            - Evaluation orchestration
        }
    }

    package "Component Managers - Separation of Concerns" {
        class AgentManager {
            +config: SABERConfig
            +session_manager: ClientSessionManager
            +saber_agent: AgentInfo?
            --
            **Agent Lifecycle**
            +__aenter__(): initialize_agent_and_session
            +__aexit__(): cleanup_agent_resources
            --
            **Responsibilities**
            - Agent discovery and initialization
            - Agent lifecycle management
            - Task creation with agent configuration
            - Agent resource cleanup
            --
            **Removed Legacy Features**
            - No dataset creation (moved to DatasetManager)
            - No task discovery (moved to DatasetManager)
            - No HTTP client creation (uses shared ClientSessionManager)
        }

        class DatasetManager {
            +config: SABERConfig
            +session_manager: ClientSessionManager
            +task_cache: Dict[str, TaskInfo]
            --
            **Dataset Operations**
            +__aenter__(): initialize_dataset_components
            +__aexit__(): cleanup_dataset_resources
            +get_tasks(): List[TaskInfo]
            +create_dataset(): inspect_ai.Dataset
            --
            **Responsibilities**
            - Task discovery and caching
            - inspect_ai Dataset creation
            - Task filtering and validation
            - Dataset resource management
        }

        class ClientSessionManager {
            +config: SessionManagerConfig
            +base_url: str
            +mcp_config: MCPConfig
            +mcp_client_pool: Dict[str, MCPClient]
            --
            **Session Management**
            +create_session(): str
            +create_episode(session_id, task_id): EpisodeCreateResponse
            +get_policy_response(session_id, episode_id): PolicyResponse?
            --
            **Task Discovery**
            +get_available_tasks(): List[TaskInfo]
            +get_tasks(task_ids): List[TaskInfo]
            --
            **MCP Operations**
            +ensure_episode_mcp_client(episode_id): MCPClient
            +cleanup_episode_mcp_client(episode_id): void
            --
            **Unified API Layer**
            - REST API for session/episode management
            - MCP API for tool execution
            - Episode-scoped MCP client pooling
        }
    }

    package "API Layer - Dual Protocol Design" {
        class SABERRestClient {
            +base_url: str
            +timeout: float
            --
            **REST Operations**
            +get_benchmark_info(): BenchmarkInfo
            +get_dataset_tasks(task_ids): List[TaskInfo]
            +post_evaluation_result(): void
            --
            **Features**
            - Type-safe responses with Pydantic models
            - Automatic error handling
            - Timeout management
        }

        class MCPClient {
            +config: MCPConfig
            +session_context: SessionContext
            +client_session: ClientSession?
            --
            **MCP Protocol**
            +__aenter__(): establish_mcp_connection
            +__aexit__(): cleanup_mcp_connection
            +list_tools(): List[MCPTool]
            +call_tool(request): MCPToolCallResponse
            --
            **Session Context**
            - Per-episode MCP client instances
            - Session/episode context via headers
            - Standard MCP protocol compliance
        }
    }

    package "Type-Safe Models" {
        class SessionManagerConfig {
            +base_url: str  # SABER server REST API URL
            +client_id: str = "saber_client"
            +rest_timeout: float = 30.0
            +mcp_url: str  # SABER server MCP endpoint URL
            +mcp_timeout: int = 30
            +mcp_retry_attempts: int = 3
            +mcp_retry_delay: float = 1.0
            +mcp_headers: Dict[str, str]
            --
            **Factory Methods**
            +from_urls(rest_url, mcp_url): SessionManagerConfig
            +to_mcp_config(): MCPConfig
            --
            **Strict Typing**
            - No extra fields allowed
            - Fail-fast validation
        }

        class AgentConfig {
            +max_steps: int = 50
            +max_errors: int = 3
            +debug_mode: bool = False
            +image: str?  # Docker image
            +env: Dict[str, str]  # Environment variables
            +resources: Dict[str, Any]  # Resource limits
            --
            **Features**
            - Extensible via "allow" extra config
            - Container execution support
            - Clean typing
        }

        class AgentInfo {
            +agent_id: str
            +name: str
            +description: str
            +version: str = "1.0.0"
            +capabilities: List[str]
            +tags: List[str]
        }
    }

    package "inspect_ai Integration" {
        class create_saber_dataset {
            +session_manager: ClientSessionManager
            +task_ids: List[str]
            --
            **inspect_ai Dataset Factory**
            +create(session_manager, task_ids): inspect_ai.Dataset
            --
            **Features**
            - Native inspect_ai.Sample creation
            - SABER task metadata integration
            - Type-safe task conversion
        }

        class SABERTaskScorer {
            +session_manager: ClientSessionManager
            --
            **inspect_ai Scorer Implementation**
            +score(state, target): Score
            --
            **Features**
            - Integration with SABER server evaluation
            - Custom scoring logic for security tasks
            - Results persistence
        }
    }
}

