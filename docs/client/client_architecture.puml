@startuml SABER Client Architecture

!theme plain
title Security Agent Benchmarking System - Client Architecture

skinparam class {
    BackgroundColor lightblue
    BorderColor black
    ArrowColor black
    FontSize 10
}

skinparam component {
    BackgroundColor lightgreen
    BorderColor black
    FontSize 10
}

package "SABER Client Infrastructure" {

    class SABERHarness {
        +config: SABERHarnessConfig
        +session_id: str
        +rest_client: SABERRestClient
        +agent: Any?
        +agent_file_path: str?
        +container_executor: ContainerEpisodeExecutor?
        +harness_logger: HarnessExecutionLogger?
        +session_log_dir: Path?
        +ui_adapter: SABERUIAdapter?
        --
        +initialize(agent, env_file): void
        +initialize_with_file(path, class): void
        +run(): HarnessRunResult
        +shutdown(): void
        --
        **Container-Only Execution**
        +_execute_episodes_container(): List[EpisodeResult]
    }

    class SABERHarnessConfig {
        +server_url: str = "http://localhost:8000"
        +mcp_url: str = "http://localhost:8001"
        +task_ids: List[str]?
        +log_level: str = "INFO"
        +timeout_minutes: int = 30
        +parallelism: int = 1
        --
        **Container Configuration**
        +sidecar_port: int = 8002
        +agent_memory_limit: str = "512m"
        +agent_cpu_limit: float = 1.0
        --
        **UI Configuration**
        +ui_enabled: bool = False
        +ui_backend: str = "AUTO"
        --
        **Logging Configuration**
        +enable_container_logs: bool = True
        +log_container_output: bool = True
    }

    package "Container Execution Infrastructure" as ContainerMode {

        class ContainerEpisodeExecutor {
            +rest_client: SABERRestClient
            +session_id: str
            +parallelism: int
            +sidecar_manager: SidecarManager
            +agent_manager: AgentManager
            +container_factory: ContainerFactory
            +container_log_manager: ContainerLogManager?
            +session_log_dir: Path?
            --
            +initialize(): void
            +execute_episodes(episodes, agent): List[EpisodeResult]
            +shutdown(): void
            --
            **Execution Strategies**
            +_execute_sequential(): List[EpisodeResult]
            +_execute_parallel(): List[EpisodeResult]
        }

        package "Container Management" {
            class SidecarManager {
                +config: SidecarConfig
                +container: Container?
                +is_running: bool
                +docker_client: DockerClient
                --
                +start_sidecar(): bool
                +stop_sidecar(): void
                +health_check(): bool
                +register_agent_session(): str
                +unregister_agent_session(): void
                +get_sidecar_url(): str
            }

            class AgentManager {
                +docker_client: DockerClient
                +active_containers: Dict[str, Container]
                +container_log_manager: ContainerLogManager?
                --
                +execute_agent_container(): AgentExecutionResult
                +monitor_container(): ContainerStatus
                +terminate_container(): void
                +collect_results(): Dict[str, Any]
                +_save_container_logs_to_file(): void
            }

            class ContainerFactory {
                +docker_client: DockerClient
                --
                +build_agent_image(): str
                +package_agent_code(): Path
                +create_agent_container(): Container
                +prepare_environment(): Dict[str, str]
                +setup_agent_directory(): Path
            }
        }

        package "MCP Sidecar Service" as SidecarService {
            class MCPProxy {
                +saber_client: aiohttp.ClientSession
                +session_registry: AgentSessionRegistry
                --
                +proxy_list_tools(): MCPResponse
                +proxy_call_tool(): MCPResponse
                +proxy_list_resources(): MCPResponse
                +health_check(): MCPResponse
            }

            class AgentSessionRegistry {
                +active_sessions: Dict[str, SessionInfo]
                --
                +register_session(): void
                +unregister_session(): void
                +get_session_mapping(): SessionInfo
                +cleanup_expired_sessions(): void
            }
        }

        package "Agent Runtime (In Container)" as AgentRuntime {
            class AgentExecutor {
                +agent: Any
                +mcp_client: StandardMCPClient
                +agent_adapter: AgentAdapter
                --
                +run(): Dict[str, Any]
                +_discover_and_load_agent(): Any
                +_initialize_mcp_client(): StandardMCPClient
                +_execute_agent(): Dict[str, Any]
            }

            class StandardMCPClient {
                +sidecar_url: str
                +session_id: str
                +http_client: aiohttp.ClientSession
                --
                +list_tools(): List[Dict[str, Any]]
                +call_tool(name, arguments): Dict[str, Any]
                +list_resources(): List[Dict[str, Any]]
                +_make_request(): Dict[str, Any]
            }

            package "Universal Agent Adapters" {
                class AgentAdapterFactory {
                    +create_adapter(agent, mcp_client): AgentAdapter
                    +detect_agent_interface(agent): AgentType
                }

                class ClassBasedAdapter {
                    +agent_instance: Any
                    +method_name: str
                    --
                    +execute(prompt, context): Dict[str, Any]
                }

                class FunctionBasedAdapter {
                    +agent_function: Callable
                    +parameter_mapping: Dict[str, str]
                    --
                    +execute(prompt, context): Dict[str, Any]
                }

                class ClassBasedAdapter {
                    +agent_instance: Any
                    +method_name: str
                    --
                    +execute(prompt, context): Dict[str, Any]
                }

                class FunctionBasedAdapter {
                    +agent_function: Callable
                    +parameter_mapping: Dict[str, str]
                    --
                    +execute(prompt, context): Dict[str, Any]
                }

                class AsyncAdapter {
                    +wrapped_adapter: AgentAdapter
                    --
                    +execute(prompt, context): Dict[str, Any]
                }
            }
        }
    }

    package "UI System" {
        class SABERUIAdapter {
            +backend_type: UIBackendType
            --
            +display_progress(): void
            +update_status(): void
            +show_results(): void
        }
    }

    package "Logging Infrastructure" {
        class ContainerLogManager {
            +session_log_dir: Path
            +container_logs_dir: Path
            --
            +setup_logging_structure(): void
            +create_log_stream_collector(): LogStreamCollector
            +get_agent_log_path(): Path
            +get_sidecar_log_path(): Path
        }

        class LogStreamCollector {
            +container: Container
            +log_file_path: Path
            +should_stop: bool
            --
            +start_streaming(): void
            +stop_streaming(): void
            +_stream_logs(): void
        }

        class HarnessExecutionLogger {
            +session_log_dir: Path
            +log_file: Path
            --
            +log_event(event): void
            +log_infrastructure_event(): void
            +log_episode_queue(): void
            +log_execution_complete(): void
        }
    }

    package "External Dependencies" {
        class DockerEngine
        class SABERServer
    }
}

' Relationships
SABERHarness --> SABERHarnessConfig : configured by
SABERHarness --> ContainerEpisodeExecutor : uses
SABERHarness --> HarnessExecutionLogger : logs to
SABERHarness --> SABERUIAdapter : displays via

ContainerEpisodeExecutor --> SidecarManager : manages
ContainerEpisodeExecutor --> AgentManager : manages
ContainerEpisodeExecutor --> ContainerFactory : uses
ContainerEpisodeExecutor --> ContainerLogManager : logs with

SidecarManager --> DockerEngine : controls containers
AgentManager --> DockerEngine : controls containers
AgentManager --> ContainerLogManager : logs via

MCPProxy --> AgentSessionRegistry : uses
AgentExecutor --> StandardMCPClient : uses
AgentExecutor --> AgentAdapterFactory : uses
StandardMCPClient --> MCPProxy : communicates via HTTP

AgentAdapterFactory --> ClassBasedAdapter : creates
AgentAdapterFactory --> FunctionBasedAdapter : creates
AgentAdapterFactory --> AsyncAdapter : wraps with

ContainerLogManager --> LogStreamCollector : creates
LogStreamCollector --> DockerEngine : streams from

MCPProxy --> SABERServer : proxies to (MCP)
SABERHarness --> SABERServer : communicates via (REST)

note top of SABERHarness : Entry Point\nMain client orchestrator\nContainer-only execution\nComprehensive logging

note top of ContainerMode : Core Architecture\n✅ Standard MCP compatibility\n✅ Agent isolation & resource limits\n✅ Robust termination & cleanup\n✅ Real-time log streaming

note bottom of DockerEngine : Container Infrastructure\nsaber/mcp-sidecar:latest\nsaber/agent-runner:latest\nIsolated networks & resource limits

@enduml
