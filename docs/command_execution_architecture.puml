@startuml Command Execution Architecture

!theme plain
title SABER Docker Sandbox Command Execution Framework - Detailed Architecture

skinparam class {
    BackgroundColor lightblue
    BorderColor black
    ArrowColor black
    FontSize 10
}

skinparam stereotype {
    ABackgroundColor lightgreen
    IBackgroundColor lightyellow
    EBackgroundColor lightcoral
    CBackgroundColor lightpink
    SBackgroundColor lightcyan
}

package "Execution Management" {

    class ExecutionManager {
        +_configuration: Dict[str, Any]
        +_executor_factory: ExecutorFactory
        +_sandbox_manager: SandboxManager
        +_environment_loader: EnvironmentLoader
        +_execution_lock: Semaphore
        --
        +step(action: Action): CommandResult
        +configure_for_task(session_id: str, task: Task): void
        +cleanup_session(session_id: str): void
        +cleanup_all_sessions(): void
        +get_security_info(): Dict[str, Any]
        +list_commands(): List[Dict[str, Any]]
        +get_execution_stats(): Dict[str, Any]
        +to_mcp_tools(): List[Dict[str, Any]]
        +get_executor(executor_type: str): DockerExecutor
    }

    class ExecutorFactory {
        +_executor_registry: Dict[str, Type[CommandExecutor]]
        +_sandbox_manager: SandboxManager
        --
        +register_executor(executor_type: str, executor_class: Type): void
        +get_executor(executor_type: str): CommandExecutor
        +get_available_executors(): List[str]
    }

    class CommandExecutor {
        +_config: Dict[str, Any]
        +_parameters: Dict[str, Parameter]
        --
        {abstract} +execute(): CommandResult
        {abstract} +setup_parameters(config: Dict[str, Any]): void
        {static} +get_default_config(): Dict[str, Any]
        +get_timeout(): float
        +validate_parameters(): ValidationResult
        +to_mcp_schema(): Dict[str, Any]
        +get_executor_type(): str
    }

    class DockerExecutor {
        +_sandbox_manager: SandboxManager
        +_config: Dict[str, Any]
        --
        {abstract} +execute(): CommandResult
        +setup_parameters(config: Dict[str, Any]): void
        +get_session_environment(): DockerSandboxEnvironment
        +ensure_container_ready(): void
        +cleanup_execution(): void
        +get_container_logs(): str
        +validate_docker_parameters(): ValidationResult
    }

    class CLIExecutor {
        +_security_command_metadata: Dict
        +_security_validator: SecurityValidator
        --
        +setup_parameters(config: Dict[str, Any]): void
        +build_command(command: str): List[str]
        +parse_output(stdout: str, stderr: str, exit_code: int): CommandResult
        +execute(action: Action): CommandResult
        +validate_parameters(action: Action): ValidationResult
        +get_security_info(): Dict[str, Any]
        +to_mcp_schema(): Dict[str, Any]
    }

    class PythonExecutor {
        +_script_templates: Dict[str, str]
        +_allowed_modules: Set[str]
        --
        +setup_parameters(config: Dict[str, Any]): void
        +build_python_script(code: str, requirements: List[str]): str
        +validate_python_code(code: str): ValidationResult
        +execute(action: Action): CommandResult
        +get_python_environment(): Dict[str, Any]
        +install_requirements(requirements: List[str]): CommandResult
        +get_security_info(): Dict[str, Any]
        +to_mcp_schema(): Dict[str, Any]
    }

    class EnvironmentLoader {
        +environments_file_path: Path
        +_templates_cache: Optional[Dict[str, Any]]
        --
        +resolve_environment(task_env_config: Any): EnvironmentSpec
        +load_template(template_name: str): EnvironmentSpec
        +build_from_granular(config: Dict[str, Any]): EnvironmentSpec
        +_merge_template_with_additions(config: Dict[str, Any]): EnvironmentSpec
        +_resolve_network(network_name: str, templates: Dict): NetworkSpec
        +_resolve_container_config(container_name: str, templates: Dict): Dict[str, Any]
        +_resolve_service_config(service_config: Dict, templates: Dict): ServiceSpec
        +_allocate_unique_subnet(): str
        +_load_templates(): Dict[str, Any]
    }

    class SecurityValidator {
        +allowed_commands: Set[str]
        --
        +validate_base_command(): void
        +validate_command_string(): ValidationResult
        +validate_arguments(): ValidationResult
        +validate_full_command(): ValidationResult
        +is_safe_path(): bool
        +get_security_info(): Dict[str, Any]
    }

    class SecurityConstants <<static>> {
        +BLOCKED_COMMANDS: Set[str]
        +DANGEROUS_PATTERNS: List[str]
        +SHELL_METACHARACTERS_PATTERN: str
        +SENSITIVE_DIRECTORIES: List[str]
        +SUSPICIOUS_EXTENSIONS: List[str]
        +DEFAULT_SECURITY_SETTINGS: Dict[str, Any]
    }

    class Parameter {
        +name: str
        +type: ParameterType
        +description: str
        +required: bool
        +default: Any
        +enum_values: List[Any]
        +min_value: Union[int, float]
        +max_value: Union[int, float]
        +pattern: str
        --
        +validate_value(): tuple[bool, str]
    }

    enum ParameterType {
        STRING
        INTEGER
        BOOLEAN
        ARRAY
        OBJECT
        NUMBER
    }

    class CommandResult {
        +success: bool
        +data: Any
        +error: str
        +execution_time: float
        +metadata: Dict[str, Any]
        +_original_data: Any
        --
        +success_result(): CommandResult
        +error_result(): CommandResult
    }

    class ValidationResult {
        +valid: bool
        +errors: List[str]
        +warnings: List[str]
        --
        +success(): ValidationResult
        +failure(): ValidationResult
        +add_error(): void
        +add_warning(): void
    }
}

package "Docker Sandbox" <<stereototype S>> {

    class SandboxManager {
        +sandbox_config: Dict[str, Any]
        +active_sessions: Dict[str, DockerSandboxEnvironment]
        --
        +create_session_environment(): DockerSandboxEnvironment
        +get_session_environment(): Optional[DockerSandboxEnvironment]
        +cleanup_session(): void
        +cleanup_all_sessions(): void
        +list_active_sessions(): List[str]
        +get_session_count(): int
        +get_sandbox_config(): Dict[str, Any]
    }

    class DockerSandboxEnvironment {
        +session_id: str
        +environment_spec: EnvironmentSpec
        +compose_project: ComposeProject
        +docker_client: DockerClient
        +compose_client: ComposeClient
        +active_services: Dict[str, Container]
        --
        +start(): void
        +stop(): void
        +execute_command(): CommandResult
        +copy_to_container(): void
        +copy_from_container(): void
        +get_execution_container(): Container
        +get_service_container(service_name: str): Optional[Container]
        +list_active_services(): List[str]
        +is_healthy(): bool
        +is_service_healthy(service_name: str): bool
        +get_service_info(): Dict[str, Any]
        +get_service_logs(service_name: str): str
        +_generate_compose_config(): Dict[str, Any]
        +_track_service_containers(): void
    }

    class EnvironmentSpec {
        +execution_config: Dict[str, Any]
        +target_services: List[ServiceSpec]
        +network_config: NetworkSpec
        +template_name: Optional[str]
        +overrides: Dict[str, Any]
        --
        +get_execution_service(): str
        +get_all_services(): List[str]
        +get_service_count(): int
        +to_compose_dict(): Dict[str, Any]
        +from_template_reference(template_name: str): EnvironmentSpec
        +from_granular_config(config: Dict): EnvironmentSpec
        +apply_overrides(overrides: Dict): void
    }

    class ServiceSpec {
        +name: str
        +image: str
        +ports: List[str]
        +environment: Dict[str, str]
        +volumes: List[str]
        +depends_on: List[str]
        +health_check: Optional[HealthCheck]
        --
        +to_compose_service(): Dict[str, Any]
    }

    class NetworkSpec {
        +mode: str
        +isolation: str
        +dns_config: Optional[Dict[str, Any]]
        --
        +to_compose_networks(): Dict[str, Any]
    }

    class HealthCheck {
        +test: List[str]
        +interval: str
        +timeout: str
        +retries: int
        +start_period: str
    }
}

' Inheritance relationships
CommandExecutor <|-- DockerExecutor
DockerExecutor <|-- CLIExecutor
DockerExecutor <|-- PythonExecutor

' Execution Manager composition relationships
ExecutionManager *-- ExecutorFactory
ExecutionManager *-- EnvironmentLoader
ExecutionManager *-- SandboxManager

' Factory relationships
ExecutorFactory *-- SandboxManager

' Sandbox relationships
SandboxManager *-- DockerSandboxEnvironment
DockerSandboxEnvironment *-- EnvironmentSpec
EnvironmentSpec *-- ServiceSpec
EnvironmentSpec *-- NetworkSpec
ServiceSpec *-- HealthCheck
DockerExecutor *-- SandboxManager
DockerSandboxEnvironment ..> CommandResult

' Executor-specific relationships
CLIExecutor *-- SecurityValidator

' Component relationships
CommandExecutor *-- Parameter
Parameter ..> ParameterType
SecurityValidator ..> SecurityConstants

' Usage relationships
CommandExecutor ..> CommandResult
CommandExecutor ..> ValidationResult

note top of ExecutionManager
**Docker Compose Execution Manager**
Central hub for all command execution components:
- Task-based configuration with environment resolution via EnvironmentLoader
- Generic factory-based executor management for scalable executor types
- Docker Compose orchestration for all sandbox environments
- Environment creation integrated with task configuration process
- Dynamic MCP tool schema generation for agent discovery
- Sequential execution with concurrency control
- MCP tools integration bridging executors to MCP protocol
- Security validation delegated to individual executors for separation of concerns
- No command analysis needed - MCP tools map directly to executor types
end note

note right of EnvironmentSpec
**Task Environment Specification**
Declarative configuration for complete task execution environment:
- Execution container configuration (CLI tools, security settings)
- Target service specifications (vulnerable web apps, databases, etc.)
- Network topology and isolation requirements
- Docker Compose orchestration for all environments
- Health check definitions for reliable service startup
- Service dependency declarations for proper startup ordering
end note

note bottom of SandboxManager
**Docker Compose Sandbox Manager**
Manages complete sandbox environments using Docker Compose orchestration:
- Creates DockerSandboxEnvironment instances from EnvironmentSpec
- Docker Compose orchestration for all sandbox environments
- Session lifecycle management with proper cleanup
- Health monitoring across all sandbox services
- Resource tracking and limits enforcement
- Network isolation and security boundaries
end note

note left of EnvironmentLoader
**Environment Configuration Resolver**
Flexible environment specification resolution:
- Template reference resolution (string → EnvironmentSpec)
- Granular configuration building (dict → EnvironmentSpec)
- Hybrid template + additions approach
- Dynamic subnet allocation for network isolation
- YAML template caching and validation
- Multi-container orchestration support
- Docker Compose configuration generation
end note

note top of DockerSandboxEnvironment
**Docker Compose Environment**
Unified Docker Compose orchestration for all sandbox environments:
- Always uses Docker Compose workflow (1 to many containers)
- Tracks all service containers (execution + target services)
- Execution service for agent command execution
- Target services for task-specific environments
- Per-service health monitoring and log access
- Service discovery and network isolation
- Health checks and dependency management
- Unified interface regardless of service count
end note

note top of CommandExecutor
Base command execution framework:
- Config-based parameter management during initialization
- Abstract setup_parameters method for executor-specific configuration
- Default configuration provider for standardized config handling
- Parameter validation and MCP schema generation
- Abstract execute method for command-specific implementation
- Timeout configuration from config dictionary
end note

@enduml
