@startuml Task Orchestrator Class Diagram - Compact

!theme plain
title τ²-Bench Comprehensive Class Diagram (Compact)

skinparam class {
    BackgroundColor lightblue
    BorderColor black
    ArrowColor black
    FontSize 10
}

skinparam stereotype {
    ABackgroundColor lightgreen
    IBackgroundColor lightyellow
    EBackgroundColor lightcoral
}

skinparam maxMessageSize 120

package "Data Models" {

    class Task {
        +id: str
        +user_scenario: UserScenario
        +evaluation_criteria: EvaluationCriteria
        +initial_state: InitialState?
        --
        +__str__(): str
    }

    class UserScenario {
        +persona: str?
        +instructions: UserInstructions
        --
        +__str__(): str
    }

    class StructuredUserInstructions {
        +domain: str
        +reason_for_call: str
        +known_info: str?
        +unknown_info: str?
        +task_instructions: str
        --
        +__str__(): str
    }

    class EvaluationCriteria {
        +actions: List[Action]?
        +env_assertions: List[EnvAssertion]?
        +communicate_info: List[str]?
        +nl_assertions: List[str]?
        +reward_basis: List[RewardType]
        --
        +__str__(): str
        +info(): dict
    }

    class Action {
        +action_id: str
        +requestor: ToolRequestor
        +name: str
        +arguments: dict
        +info: str?
        +compare_args: List[str]?
        --
        +get_func_format(): str
        +compare_with_tool_call(): bool
        +__str__(): str
    }

    class InitialState {
        +initialization_data: InitializationData?
        +initialization_actions: List[EnvFunctionCall]?
        +message_history: List[Message]?
        --
        +__str__(): str
    }

    class InitializationData {
        +agent_data: dict?
        +user_data: dict?
    }
}

package "Message System" {

    abstract class Message {
        +role: str
        +turn_idx: int?
        +timestamp: str
        --
        +validate(): void
        +__str__(): str
    }

    class ParticipantMessageBase {
        +content: str?
        +tool_calls: List[ToolCall]?
        +cost: float?
        +usage: dict?
        +raw_data: dict?
        --
        +validate(): void
        +has_text_content(): bool
        +is_tool_call(): bool
        +__str__(): str
    }

    class AssistantMessage {
        +role: "assistant"
        --
        +validate(): void
    }

    class UserMessage {
        +role: "user"
        --
        +validate(): void
    }

    class ToolMessage {
        +role: "tool"
        +id: str
        +content: str
        +requestor: ToolRequestor
        +error: bool
        --
        +validate(): void
    }

    class MultiToolMessage {
        +role: "tool"
        +tool_messages: List[ToolMessage]
        --
        +validate(): void
    }

    class ToolCall {
        +id: str
        +name: str
        +arguments: dict
        +requestor: ToolRequestor
        --
        +__str__(): str
        +__eq__(other): bool
    }

    class SystemMessage {
        +role: "system"
        +content: str?
        --
        +__str__(): str
        +__eq__(other): bool
    }
}

package "Agent System" {

    abstract class BaseAgent<AgentState> {
        {abstract} +generate_next_message(): tuple
        {abstract} +get_init_state(): AgentState
        {abstract} +is_stop(): bool
        {abstract} +set_seed(): void
    }

    class LLMAgent {
        +tools: List[Tool]
        +domain_policy: str
        +llm: str
        +llm_args: dict
        -system_message: str
        --
        +generate_next_message(): tuple
        +get_init_state(): AgentState
        +is_stop(): bool
        +set_seed(): void
        -build_system_message(): str
    }

    class LLMGTAgent {
        +task: Task
        --
        +generate_next_message(): tuple
        +check_valid_task(): bool
    }

    class LLMSoloAgent {
        +task: Task
        --
        +generate_next_message(): tuple
        +check_valid_task(): bool
    }
}

package "User System" {

    abstract class BaseUser {
        {abstract} +generate_next_message(): tuple
        {abstract} +get_init_state(): UserState
        {abstract} +set_seed(): void
    }

    class UserState {
        +system_messages: List[SystemMessage]
        +messages: List[APICompatibleMessage]
        --
        +flip_roles(): List[APICompatibleMessage]
    }

    class UserSimulator {
        +tools: List[Tool]?
        +instructions: str
        +llm: str
        +llm_args: dict
        --
        +generate_next_message(): tuple
        +get_init_state(): UserState
        +is_stop(): bool
        +set_seed(): void
    }

    class DummyUser {
        --
        +generate_next_message(): tuple
        +get_init_state(): UserState
        +set_seed(): void
    }
}

package "Environment System" {

    class Environment {
        +domain_name: str
        +policy: str
        +tools: ToolKitBase?
        +user_tools: ToolKitBase?
        +solo_mode: bool
        --
        +get_domain_name(): str
        +get_policy(): str
        +get_tools(): List[Tool]
        +get_user_tools(): List[Tool]
        +get_response(): ToolMessage
        +make_tool_call(): Any
        +sync_tools(): void
        +set_state(): void
        +get_info(): EnvironmentInfo
        -validate_solo_mode(): void
    }

    class EnvironmentInfo {
        +domain_name: str
        +policy: str
        +tool_defs: dict[str, ToolSignature]?
    }

    abstract class ToolKitBase {
        {abstract} +get_tools(): dict[str, Tool]
        {abstract} +sync_tools(): void
    }

    class Tool {
        +name: str
        +description: str
        +parameters: dict
        +function: Callable
        --
        +to_dict(): dict
        +__call__(): Any
    }

    class DB {
        +data: dict
        --
        +get(): Any
        +set(): void
        +update(): void
        +query(): List[dict]
    }
}

package "Orchestration System" {

    enum Role {
        AGENT
        USER
        ENV
    }

    enum TerminationReason {
        USER_STOP
        AGENT_STOP
        MAX_STEPS
        TOO_MANY_ERRORS
    }

    class Orchestrator {
        +domain: str
        +agent: BaseAgent
        +user: BaseUser
        +environment: Environment
        +task: Task
        +max_steps: int
        +max_errors: int
        +seed: int?
        +solo_mode: bool
        -agent_state: AgentState?
        -user_state: UserState?
        -trajectory: List[Message]
        -step_count: int
        -done: bool
        -termination_reason: TerminationReason?
        -num_errors: int
        -from_role: Role?
        -to_role: Role?
        -message: Message?
        --
        +initialize(): void
        +run(): SimulationRun
        +step(): void
        +get_trajectory(): List[Message]
        +validate_message_history(): void
        -_add_timestamps(): List[Message]
        -_initialize_environment(): void
    }

    class SimulationRun {
        +id: str
        +task_id: str
        +start_time: str
        +end_time: str
        +duration: float
        +termination_reason: str
        +reward_info: RewardInfo?
        +user_cost: float?
        +agent_cost: float?
        +messages: List[Message]
        +trial: int?
        +seed: int?
    }
}

package "Evaluation System" {

    enum EvaluationType {
        ALL
        ACTIONS_ONLY
        ENV_ASSERTIONS_ONLY
        NL_ASSERTIONS_ONLY
    }

    abstract class EvaluatorBase {
        {abstract} +evaluate(): float
    }

    class ActionEvaluator {
        --
        +evaluate(): float
        -check_action_sequence(): float
    }

    class EnvAssertionEvaluator {
        --
        +evaluate(): float
        -execute_assertions(): float
    }

    class NLAssertionEvaluator {
        --
        +evaluate(): float
        -llm_evaluate_assertions(): float
    }

    class RewardInfo {
        +reward: float
        +breakdown: dict
        +evaluator_results: dict
    }
}

package "Registry & Configuration" {

    class Registry {
        -env_constructors: dict
        -agent_constructors: dict
        -user_constructors: dict
        -task_loaders: dict
        --
        +get_info(): RegistryInfo
        +get_env_constructor(): Callable
        +get_agent_constructor(): Callable
        +get_user_constructor(): Callable
        +get_tasks_loader(): Callable
        +register_domain(): void
        +register_agent(): void
        +register_user(): void
    }

    class RegistryInfo {
        +domains: List[str]
        +agents: List[str]
        +users: List[str]
        +task_sets: List[str]
    }

    class RunConfig {
        +domain: str
        +agent: str
        +user: str
        +llm_agent: str
        +llm_user: str
        +llm_args_agent: dict
        +llm_args_user: dict
        +num_trials: int
        +max_steps: int
        +max_errors: int
        +max_concurrency: int
        +seed: int?
        +save_to: str?
        +task_ids: List[str]?
        +num_tasks: int?
    }
}

package "Execution Engine" {

    class Results {
        +info: Info
        +tasks: List[Task]
        +simulations: List[SimulationRun]
    }

    class Info {
        +git_commit: str
        +num_trials: int
        +max_steps: int
        +max_errors: int
        +user_info: UserInfo
        +agent_info: AgentInfo
        +environment_info: EnvironmentInfo
        +seed: int?
    }

    class AgentInfo {
        +implementation: str
        +llm: str
        +llm_args: dict
    }

    class UserInfo {
        +implementation: str
        +llm: str?
        +llm_args: dict?
        +global_simulation_guidelines: str
    }
}

' Relationships
Message <|-- ParticipantMessageBase
ParticipantMessageBase <|-- AssistantMessage
ParticipantMessageBase <|-- UserMessage
Message <|-- ToolMessage
Message <|-- MultiToolMessage
Message <|-- SystemMessage

BaseAgent <|-- LLMAgent
LLMAgent <|-- LLMGTAgent
LLMAgent <|-- LLMSoloAgent

BaseUser <|-- UserSimulator
BaseUser <|-- DummyUser

EvaluatorBase <|-- ActionEvaluator
EvaluatorBase <|-- EnvAssertionEvaluator
EvaluatorBase <|-- NLAssertionEvaluator

Task *-- UserScenario
Task *-- EvaluationCriteria
Task *-- InitialState
UserScenario *-- StructuredUserInstructions
EvaluationCriteria *-- Action
InitialState *-- InitializationData
InitialState *-- EnvFunctionCall

Orchestrator *-- BaseAgent
Orchestrator *-- BaseUser
Orchestrator *-- Environment
Orchestrator *-- Task
Orchestrator ..> Role
Orchestrator ..> TerminationReason
Orchestrator ..> SimulationRun

Environment *-- ToolKitBase
Environment *-- DB
ToolKitBase *-- Tool

UserSimulator *-- UserState
UserState *-- SystemMessage

ParticipantMessageBase *-- ToolCall
ToolMessage ..> ToolCall
MultiToolMessage *-- ToolMessage

Registry --> RegistryInfo
Results *-- Info
Results *-- Task
Results *-- SimulationRun
Info *-- AgentInfo
Info *-- UserInfo
Info *-- EnvironmentInfo

SimulationRun *-- RewardInfo
SimulationRun *-- Message

note top of BaseAgent
Generic base class with
AgentState type parameter
end note

note top of Orchestrator
Core orchestration logic:
• State machine with roles
• Message routing
• Error handling
• Termination detection
end note

note top of Environment
Domain-specific environment:
• Tool execution
• Database operations
• Policy enforcement
• State management
end note

note top of Registry
Singleton registry managing:
• Domain constructors
• Agent implementations
• User implementations
• Task loaders
end note

@enduml
