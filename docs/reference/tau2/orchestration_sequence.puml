@startuml Task Orchestrator Sequence

!theme plain
title τ²-Bench Task Orchestration Sequence Diagram

participant "CLI" as CLI
participant "Registry" as Registry
participant "TaskLoader" as TaskLoader
participant "run_tasks" as RunTasks
participant "ThreadPoolExecutor" as ThreadPool
participant "run_task" as RunTask
participant "Agent\n(LLMAgent)" as Agent
participant "User\n(UserSimulator)" as User
participant "Environment" as Environment
participant "Orchestrator" as Orchestrator
participant "Evaluator" as Evaluator

== Task Loading Phase ==

CLI -> Registry: get_options()
note right: Get available domains,\nagents, users

CLI -> Registry: get_tasks_loader(domain)
Registry -> TaskLoader: get_tasks()
TaskLoader -> TaskLoader: load tasks.json
note right: Parse JSON into\nTask objects

TaskLoader --> CLI: List[Task]

== Execution Setup ==

CLI -> RunTasks: run_tasks(domain, tasks, config)
RunTasks -> ThreadPool: create executor(max_concurrency)

loop for each task x num_trials
    RunTasks -> ThreadPool: submit(run_task, task, trial, seed)

    == Individual Task Execution ==

    ThreadPool -> RunTask: run_task(task, config)

    ' Component Creation
    RunTask -> Registry: get_env_constructor(domain)
    RunTask -> Environment: **new** Environment(domain, policy, tools)
    Environment -> Environment: load db.json, policy.md

    RunTask -> Registry: get_agent_constructor(agent_type)
    RunTask -> Agent: **new** Agent(tools, policy, llm_config)

    RunTask -> Registry: get_user_constructor(user_type)
    RunTask -> User: **new** User(tools, instructions, llm_config)

    RunTask -> Orchestrator: **new** Orchestrator(agent, user, env, task)

    == Orchestrator Initialization ==

    RunTask -> Orchestrator: run()
    Orchestrator -> Orchestrator: initialize()

    ' State Initialization
    Orchestrator -> Agent: get_init_state(message_history?)
    Agent --> Orchestrator: AgentState

    Orchestrator -> User: get_init_state(message_history?)
    User --> Orchestrator: UserState

    Orchestrator -> Environment: set_state(initialization_data, actions)
    Environment -> Environment: apply initial DB updates
    Environment -> Environment: execute initialization actions
    Environment --> Orchestrator: ack

    ' Set initial message flow
    alt if no message_history
        Orchestrator -> Orchestrator: set first_message = DEFAULT_FIRST_AGENT_MESSAGE
        Orchestrator -> Orchestrator: from_role = AGENT, to_role = USER
    else message_history exists
        Orchestrator -> Orchestrator: validate_message_history(messages)
        Orchestrator -> Orchestrator: determine from_role/to_role from last message
    end

    == Main Orchestration Loop ==

    loop while not done AND step_count < max_steps AND errors < max_errors

        Orchestrator -> Orchestrator: step()

        alt from_role=AGENT/ENV → to_role=USER
            note over Orchestrator, User: **AGENT/ENV → USER Flow**
            Orchestrator -> User: generate_next_message(message, user_state)
            note right: Input: AssistantMessage |\nToolMessage | MultiToolMessage

            User -> User: process message with LLM
            User -> User: generate response based on task instructions
            User --> Orchestrator: (UserMessage, UserState)

            Orchestrator -> Orchestrator: user_msg.validate()
            Orchestrator -> Orchestrator: UserSimulator.is_stop(user_msg)?

            alt user says "###STOP###"
                Orchestrator -> Orchestrator: done = True, termination = USER_STOP
            else
                Orchestrator -> Orchestrator: trajectory.append(user_msg)
                Orchestrator -> Orchestrator: from_role = USER

                alt user_msg.is_tool_call()
                    Orchestrator -> Orchestrator: to_role = ENV
                else text message
                    Orchestrator -> Orchestrator: to_role = AGENT
                end
            end

        else from_role=USER/ENV → to_role=AGENT
            note over Orchestrator, Agent: **USER/ENV → AGENT Flow**
            Orchestrator -> Agent: generate_next_message(message, agent_state)
            note right: Input: UserMessage |\nToolMessage | MultiToolMessage

            Agent -> Agent: process message with LLM
            Agent -> Agent: decide on response/tool calls
            Agent --> Orchestrator: (AssistantMessage, AgentState)

            Orchestrator -> Orchestrator: agent_msg.validate()
            Orchestrator -> Orchestrator: agent.is_stop(agent_msg)?

            alt agent decides to stop
                Orchestrator -> Orchestrator: done = True, termination = AGENT_STOP
            else
                Orchestrator -> Orchestrator: trajectory.append(agent_msg)
                Orchestrator -> Orchestrator: from_role = AGENT

                alt agent_msg.is_tool_call()
                    Orchestrator -> Orchestrator: to_role = ENV
                else text message
                    Orchestrator -> Orchestrator: to_role = USER
                end
            end

        else from_role=AGENT/USER → to_role=ENV
            note over Orchestrator, Environment: **AGENT/USER → ENV Flow**

            Orchestrator -> Orchestrator: validate message.is_tool_call()

            loop for each tool_call in message.tool_calls
                Orchestrator -> Environment: get_response(tool_call)

                Environment -> Environment: make_tool_call(name, requestor, **args)
                note right: Execute domain-specific\ntool function

                Environment -> Environment: sync_tools()
                note right: Update tool availability\nafter state changes

                alt tool execution successful
                    Environment --> Orchestrator: ToolMessage(content, requestor, error=False)
                else tool execution failed
                    Environment --> Orchestrator: ToolMessage(error_msg, requestor, error=True)
                    Orchestrator -> Orchestrator: num_errors++
                end
            end

            Orchestrator -> Orchestrator: trajectory.extend(tool_messages)

            alt multiple tool responses
                Orchestrator -> Orchestrator: create MultiToolMessage(tool_messages)
            end

            Orchestrator -> Orchestrator: from_role = ENV, to_role = original_requestor
        end

        Orchestrator -> Orchestrator: step_count++

        ' Check termination conditions
        alt step_count >= max_steps
            Orchestrator -> Orchestrator: done = True, termination = MAX_STEPS
        else num_errors >= max_errors
            Orchestrator -> Orchestrator: done = True, termination = TOO_MANY_ERRORS
        end
    end

    == Simulation Completion ==

    Orchestrator -> Orchestrator: get_trajectory()
    note right: Sort messages by timestamp,\nadd turn_idx

    Orchestrator --> RunTask: SimulationRun(trajectory, metadata)

    == Evaluation Phase ==

    RunTask -> Evaluator: evaluate_simulation(domain, task, simulation)

    Evaluator -> Evaluator: check evaluation_criteria

    alt evaluate actions
        Evaluator -> Evaluator: compare simulation actions vs expected actions
    end

    alt evaluate environment assertions
        Evaluator -> Environment: execute env_assertions
        Environment --> Evaluator: assertion results
    end

    alt evaluate natural language assertions
        Evaluator -> Evaluator: LLM-based evaluation of nl_assertions
    end

    Evaluator -> Evaluator: compute final reward based on reward_basis
    Evaluator --> RunTask: RewardInfo(reward, breakdown)

    RunTask -> RunTask: simulation.reward_info = reward_info
    RunTask --> ThreadPool: SimulationRun (complete)
end

ThreadPool --> RunTasks: List[SimulationRun]

== Results Processing ==

RunTasks -> RunTasks: compute_metrics(simulation_results)
RunTasks -> RunTasks: save results to JSON file

RunTasks --> CLI: Results(simulations, metrics)

note over CLI
**Key Message Types:**
• AssistantMessage: from Agent to User/Env
• UserMessage: from User to Agent/Env
• ToolMessage: from Environment to requester
• MultiToolMessage: multiple tool responses
• ToolCall: tool invocation request

**Termination Conditions:**
• USER_STOP: User says "###STOP###"
• AGENT_STOP: Agent decides task complete
• MAX_STEPS: Reached step limit
• TOO_MANY_ERRORS: Exceeded error threshold
end note

@enduml
