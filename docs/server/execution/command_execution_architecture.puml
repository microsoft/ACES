@startuml Command Execution Architecture

!theme plain
title SABER Docker Sandbox Command Execution Framework - Episode-Based Static Compose Files

skinparam class {
    BackgroundColor lightblue
    BorderColor black
    ArrowColor black
    FontSize 10
}

skinparam stereotype {
    ABackgroundColor lightgreen
    IBackgroundColor lightyellow
    EBackgroundColor lightcoral
    CBackgroundColor lightpink
    SBackgroundColor lightcyan
}

package "Execution Management" {

    class ExecutionManager {
        +_config_dir: str
        +_configuration: Dict[str, Any]
        +_executor_factory: Optional[ExecutorFactory]
        +_sandbox_manager: Optional[SandboxEnvironmentManager]
        +_permanent_environment_manager: Optional[PermanentEnvironmentManager]
        +_active_executions: Dict[str, int]
        +_max_concurrent_per_episode: int
        +_debug_mode: bool
        --
        +step(action: Action, context?: Dict): CommandResult
        +configure_for_task(episode_id: str, task: Task, session_id?: str, target_episode_id?: str): void
        +initialize_permanent_environment(permanent_manager: PermanentEnvironmentManager): void
        +cleanup_episode(episode_id: str, context?: Dict): bool
        +is_sandbox_ready(): bool
        +to_mcp_tools(episode_id?: str): List[Dict[str, Any]]
        +get_executor(executor_type: str, episode_id?: str): DockerExecutor
        +get_available_executors(episode_id?: str): List[str]
        +get_execution_stats(): Dict[str, Any]
        +list_commands(episode_id?: str): List[Dict[str, Any]]
        +_load_custom_executors(config_dir: str): void
    }

    class ExecutorFactory {
        +_sandbox_manager: SandboxEnvironmentManager
        +_configuration: Dict[str, Any]
        +_executor_instances: Dict[str, DockerExecutor]
        +_all_available_executors: List[str]
        +_episode_configurations: Dict[str, Dict[str, Any]]
        --
        +register_episode_configuration(episode_id: str, allowed_executors?: List[str], episode_config?: Dict): void
        +unregister_episode_configuration(episode_id: str): void
        +get_available_executors(episode_id?: str): List[str]
        +get_executor(executor_type: str, episode_id?: str, force_new?: bool): DockerExecutor
        +create_executor(executor_type: str): DockerExecutor
        +update_configuration(config: Dict): void
        +clear_instances(): void
    }

    class ExecutorRegistry {
        +_registered_executors: Dict[str, Type[DockerExecutor]]
        +_registration_sources: Dict[str, str]
        --
        +register_executor_class(executor_type: str, executor_class: Type[DockerExecutor], source?: str): void
        +register_executor_from_file(executor_type: str, file_path: str, class_name: str): void
        +get_executor_class(executor_type: str): Type[DockerExecutor]
        +get_available_executors(): List[str]
        +is_registered(executor_type: str): bool
        +load_executors_from_directory(directory: str): Dict[str, str]
        +_validate_executor_class(executor_class: Type): void
    }

    class CommandExecutor {
        +_config: Dict[str, Any]
        +_parameters: Dict[str, Parameter]
        --
        {abstract} +setup_parameters(config: Dict[str, Any]): void
        {abstract} +execute(parameters: Dict, context: Dict): CommandResult
        {static} +get_default_config(): Dict[str, Any]
        +get_timeout(): float
        +add_parameter(parameter: Parameter): void
        +validate_parameters(parameters: Dict): ValidationResult
        +to_mcp_schema(): Dict[str, Any]
        +get_executor_type(): str
        +__call__(parameters: Dict, context: Dict): CommandResult
    }

    class DockerExecutor {
        +_sandbox_manager: SandboxEnvironmentManager
        --
        {abstract} +execute(parameters: Dict, context: Dict): CommandResult
        +setup_parameters(config: Dict[str, Any]): void
        +get_episode_environment(episode_id: str): ComposeOrchestrator
        +ensure_container_ready(episode_id: str): bool
        +cleanup_execution(episode_id: str): void
        +get_container_logs(episode_id: str): str
        +create_with_config(sandbox_manager, config?, additional_params?, **kwargs): DockerExecutor
        +_validate_docker_environment(episode_id: str): ValidationResult
    }
}

package "Standard Executors (standard_registry/)" {

    class BashExecutor {
        +_executor_metadata: Dict
        +_security_validator: SecurityValidator
        --
        +setup_parameters(config: Dict[str, Any]): void
        +build_command(command: str): List[str]
        +execute(parameters: Dict, context: Dict): CommandResult
        +validate_command_string(command: str): ValidationResult
        +get_security_info(): Dict[str, Any]
        +to_mcp_schema(): Dict[str, Any]
        +create_with_config(sandbox_manager, config?, additional_params?, **kwargs): BashExecutor
    }

    class PythonExecutor {
        +_script_templates: Dict[str, str]
        +_allowed_modules: Set[str]
        +_requirements_cache: Dict[str, bool]
        --
        +setup_parameters(config: Dict[str, Any]): void
        +build_python_script(code: str, requirements?: List[str]): str
        +validate_python_code(code: str): ValidationResult
        +execute(parameters: Dict, context: Dict): CommandResult
        +get_python_environment(): Dict[str, Any]
        +install_requirements(requirements: List[str]): CommandResult
        +to_mcp_schema(): Dict[str, Any]
        +create_with_config(sandbox_manager, config?, additional_params?, **kwargs): PythonExecutor
    }

    class SQLExecutor {
        +_connection_manager: Dict[str, Any]
        +_query_templates: Dict[str, str]
        --
        +setup_parameters(config: Dict[str, Any]): void
        +execute_query(query: str, connection_params: Dict): CommandResult
        +validate_sql_query(query: str): ValidationResult
        +execute(parameters: Dict, context: Dict): CommandResult
        +get_database_info(): Dict[str, Any]
        +to_mcp_schema(): Dict[str, Any]
        +create_with_config(sandbox_manager, config?, additional_params?, **kwargs): SQLExecutor
    }

    class SecurityValidator {
        +allowed_commands: Optional[Set[str]]
        +_base_allowed_commands: Set[str]
        --
        +validate_command_string(command: str): ValidationResult
        +validate_base_command(command: str): ValidationResult
        +validate_arguments(args: List[str]): ValidationResult
        +validate_full_command(command_parts: List[str]): ValidationResult
        +is_safe_path(path: str): bool
        +get_security_info(): Dict[str, Any]
        +_is_dangerous_pattern(text: str): bool
        +_contains_shell_metacharacters(text: str): bool
    }

    class SecurityConstants <<static>> {
        +BLOCKED_COMMANDS: Set[str]
        +DANGEROUS_PATTERNS: List[str]
        +SHELL_METACHARACTERS_PATTERN: str
        +SENSITIVE_DIRECTORIES: List[str]
        +SUSPICIOUS_EXTENSIONS: List[str]
        +DEFAULT_SECURITY_SETTINGS: Dict[str, Any]
        +BASE_ALLOWED_COMMANDS: Set[str]
    }

    class Parameter {
        +name: str
        +type: ParameterType
        +description: str
        +required: bool
        +default: Any
        +enum_values: List[Any]
        +min_value: Union[int, float]
        +max_value: Union[int, float]
        +pattern: str
        --
        +validate_value(): tuple[bool, str]
    }

    enum ParameterType {
        STRING
        INTEGER
        BOOLEAN
        ARRAY
        OBJECT
        NUMBER
    }

    class CommandResult {
        +success: bool
        +data: Any
        +error: str
        +execution_time: float
        +metadata: Dict[str, Any]
        +_original_data: Any
        --
        +success_result(): CommandResult
        +error_result(): CommandResult
    }

    class ValidationResult {
        +valid: bool
        +errors: List[str]
        +warnings: List[str]
        --
        +success(): ValidationResult
        +failure(): ValidationResult
        +add_error(): void
        +add_warning(): void
    }
}

package "Docker Sandbox" <<stereototype S>> {

    class SandboxEnvironmentManager {
        +sandbox_config: Dict[str, Any]
        +active_orchestrators: Dict[str, ComposeOrchestrator]
        +episode_compose_files: Dict[str, Path]
        +domain: str
        +environments_base_path: Path
        +logging_config: Dict[str, Any]
        +_is_ready: bool
        --
        +is_ready(): bool
        +wait_for_ready(timeout: int): bool
        +create_episode_environment(episode_id: str, sandbox_environment: str, target_episode_id?: str): bool
        +get_episode_environment(episode_id: str): Optional[ComposeOrchestrator]
        +stop_episode_environment(episode_id: str): bool
        +list_active_episodes(): List[str]
        +get_episode_count(): int
        +get_sandbox_config(): Dict[str, Any]
        +_get_compose_file_path(sandbox_environment: str): Path
    }

    class PermanentEnvironmentManager {
        +permanent_config: Dict[str, Any]
        +permanent_services: Dict[str, PermanentService]
        +permanent_network: DockerNetwork
        --
        +start_permanent_services(env_spec: PermanentEnvironmentSpec): void
        +stop_permanent_services(): void
        +get_service_endpoints(service_name: str): ServiceEndpoints
        +connect_sandbox_to_permanent(sandbox_env: ComposeOrchestrator, episode_id: str): void
        +is_service_healthy(service_name: str): bool
        +list_permanent_services(): List[str]
        +get_permanent_network_info(): Dict[str, Any]
    }

    class ComposeOrchestrator {
        +execution_service_name: Optional[str]
        +episode_id: Optional[str]
        +compose_file_path: Optional[Path]
        +compose_data: Optional[dict]
        +_docker_client: Any
        +config_type: str
        +container_logger: Optional[ContainerLoggingManager]
        +health_checker: ComposeHealthChecker
        +project_name: str
        --
        +start_environment(compose_file_path: str, config: ComposeEnvironmentConfig): subprocess.CompletedProcess
        +stop_environment(): subprocess.CompletedProcess
        +execute_command(command: str, working_dir?: str, timeout?: float, env_vars?: Dict): CommandResult
        +copy_to_container(source: str, dest: str): bool
        +copy_from_container(source: str, dest: str): bool
        +get_execution_service_name(): str
        +list_services(): List[str]
        +is_service_healthy(service_name: str): bool
        +get_service_info(service_name: str): Dict[str, Any]
        +get_service_logs(service_name?: str, tail?: int): str
        +_identify_execution_service(compose_path: Path): str
        +_inject_episode_network(compose_file: str, config: ComposeEnvironmentConfig, env_vars: Dict): str
        +_log_resolved_compose_config(compose_file: str, env_vars: Dict): void
    }

    class ComposeEnvironmentConfig {
        +episode_id: str
        +config_type: str
        +target_episode_id: Optional[str]
        +sandbox_environment: Optional[str]
        --
        +get_project_name(): str
        +to_env_dict(): Dict[str, str]
        +from_sandbox_config(episode_id: str, sandbox_environment: str, target_episode_id?: str): ComposeEnvironmentConfig
        +from_permanent_config(permanent_environment: str): ComposeEnvironmentConfig
    }

    class ComposeHealthChecker {
        +check_service_health(container: Container): bool
        +wait_for_healthy(containers: List[Container], timeout: int): bool
        +get_service_status(container: Container): str
    }

    class PermanentEnvironmentSpec {
        +permanent_services: List[PermanentServiceSpec]
        +networks: List[NetworkSpec]
        +environment_name: str
        --
        +get_all_services(): List[str]
        +get_service_endpoints(service_name: str): ServiceEndpoints
        +to_compose_dict(): Dict[str, Any]
        +validate(): ValidationResult
    }

    class PermanentServiceSpec {
        +name: str
        +image: str
        +ports: List[str]
        +environment: Dict[str, str]
        +volumes: List[str]
        +health_check: Optional[HealthCheck]
        +restart_policy: str
        --
        +to_compose_service(): Dict[str, Any]
    }

    class NetworkSpec {
        +name: str
        +driver: str
        +ipam_config: Optional[Dict[str, Any]]
        +is_permanent: bool
        --
        +to_compose_networks(): Dict[str, Any]
        +get_subnet(): str
    }

    class HealthCheck {
        +test: List[str]
        +interval: str
        +timeout: str
        +retries: int
        +start_period: str
    }
}

' Inheritance relationships
CommandExecutor <|-- DockerExecutor
DockerExecutor <|-- BashExecutor
DockerExecutor <|-- PythonExecutor
DockerExecutor <|-- SQLExecutor

' Execution Manager composition relationships
ExecutionManager *-- ExecutorFactory
ExecutionManager *-- SandboxEnvironmentManager
ExecutionManager ..> PermanentEnvironmentManager : optional

' Factory and Registry relationships
ExecutorFactory ..> ExecutorRegistry : uses
ExecutorRegistry o-- BashExecutor : registers
ExecutorRegistry o-- PythonExecutor : registers
ExecutorRegistry o-- SQLExecutor : registers

' Sandbox relationships
SandboxEnvironmentManager *-- ComposeOrchestrator
PermanentEnvironmentManager *-- PermanentServiceSpec
ComposeOrchestrator *-- ComposeHealthChecker
ComposeOrchestrator ..> ComposeEnvironmentConfig : uses
PermanentEnvironmentSpec *-- PermanentServiceSpec
PermanentEnvironmentSpec *-- NetworkSpec
PermanentServiceSpec *-- HealthCheck
DockerExecutor *-- SandboxEnvironmentManager
ComposeOrchestrator ..> CommandResult

' Executor-specific relationships
BashExecutor *-- SecurityValidator
SecurityValidator ..> SecurityConstants

' Component relationships
CommandExecutor *-- Parameter
Parameter ..> ParameterType

' Usage relationships
CommandExecutor ..> CommandResult
CommandExecutor ..> ValidationResult

note top of ExecutionManager
**Episode-Based Docker Compose Execution Manager**
Central hub with registry-based executor discovery:
- Episode-scoped execution tracking (not session-scoped)
- Optional permanent environment manager (initialized separately)
- Concurrent execution tracking per episode (max_concurrent_per_episode = 3)
- Custom executor loading from config directory
- Registry-based executor discovery and instantiation
- Task-based configuration with static compose file resolution
- Episode-scoped container lifecycle management
- MCP tools integration with dynamic schema generation
- Async execution pattern with context passing
- Direct component cleanup (no CleanupManager)
- Debug mode support via SABER_DEBUG_MODE env variable
end note

note top of ExecutorRegistry
**Global Executor Registration System**
Self-registering executor pattern:
- Executors register themselves on import via register_executor()
- Standard executors in standard_registry/ auto-register
- Custom executors loaded from config directory
- Validation of executor classes during registration
- Source tracking for debugging and conflict resolution
- Thread-safe registration process
- Single global registry instance (executor_registry)
end note

note right of ComposeEnvironmentConfig
**Episode Environment Configuration**
Declarative configuration for episode-specific environments:
- Episode-scoped compose project naming
- Static compose file reference (e.g., "excytin_sandbox")
- Optional target episode for network attachment
- Environment variable substitution for compose files
- Automatic network injection for episode dependencies
- Configuration type tracking (sandbox vs permanent)
end note

note bottom of SandboxEnvironmentManager
**Static Compose File Sandbox Manager**
Manages ephemeral sandbox environments using static compose files:
- Episode-scoped lifecycle management (not session-scoped)
- Static compose file resolution from environments/sandbox directory
- Episode-specific project naming for Docker Compose
- ComposeOrchestrator instances per episode
- Health monitoring across all sandbox services
- Episode environment creation with optional network attachment
- Lazy validation of environments directory
end note

note bottom of PermanentEnvironmentManager
**Permanent Environment Manager**
Manages server-scoped persistent services that remain active across episodes:
- Creates and manages long-lived Docker services on server startup
- Provides permanent network bridge for cross-episode service sharing
- Service health monitoring and automatic recovery
- Service endpoint discovery for connecting sandbox environments
- Network attachment for episode orchestrators
- Graceful shutdown coordination with server lifecycle
- Persistent storage and configuration management
end note

note top of ComposeOrchestrator
**Static Compose File Orchestrator**
Unified Docker Compose orchestration using static compose files:
- Always uses Docker Compose CLI workflow
- Static compose file with environment variable substitution
- Episode-specific project naming for isolation
- Automatic network injection for episode dependencies
- Execution service identification via labels
- Per-service health monitoring and log access
- Command execution in designated execution service
- Container lifecycle logging via ContainerLoggingManager
- Health checks via ComposeHealthChecker
end note

note top of CommandExecutor
**Base Command Execution Framework**
Async execution with registry integration:
- Async execute method with parameters and context
- Callable interface via __call__ for intuitive usage
- Config-based parameter management during initialization
- Abstract setup_parameters method for executor-specific configuration
- Default configuration provider for standardized config handling
- Parameter validation and MCP schema generation
- create_with_config factory method for standardized instantiation
- Timeout configuration from config dictionary
end note

note top of ExecutorFactory
**Episode-Aware Executor Factory**
Dynamic executor creation with episode-specific configuration:
- Episode-specific allowed executor lists
- Registry-based executor class lookup
- Episode configuration registration/unregistration
- Executor instance caching and reuse
- Configuration management per episode
- Validates executor availability per episode
- Falls back to all executors if episode not configured
end note

note right of BashExecutor
**Standard CLI Executor**
Registered as "bash" executor:
- Located in standard_registry/bash_executor.py
- Auto-registers on import: register_executor("bash", BashExecutor, "standard")
- Shell execution mode with security validation
- Command chaining and timeout enforcement
- Working directory and environment variable support
- Comprehensive security validation via SecurityValidator
end note

note right of PythonExecutor
**Standard Python Executor**
Registered as "python" executor:
- Located in standard_registry/python_executor.py
- Auto-registers on import: register_executor("python", PythonExecutor, "standard")
- Python code execution with requirements management
- Script template system for common patterns
- Module whitelisting and code validation
- Requirements caching and installation
end note

note right of SQLExecutor
**Standard SQL Executor**
Registered as "sql" executor:
- Located in standard_registry/sql_executor.py
- Auto-registers on import: register_executor("sql", SQLExecutor, "standard")
- SQL query execution with connection management
- Multi-database support (MySQL, PostgreSQL, SQLite)
- Query validation and result formatting
- Connection pooling and timeout handling
end note

@enduml
