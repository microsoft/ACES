@startuml SABER Server Architecture - Detailed

!theme plain
title Security Agent Benchmarking System - Detailed Server Architecture

skinparam class {
    BackgroundColor lightblue
    BorderColor black
    ArrowColor black
    FontSize 10
}

package "Domain Server Core" {

    class SessionManager {
        +domain_name: str
        +active_sessions: Dict[str, ClientSession]
        +task_manager: TaskManager
        +execution_manager: ExecutionManager
        +policy_manager: PolicyManager
        +evaluation_manager: EvaluationManager
        +api: SessionAPI
        --
        +start_server(): void
        +shutdown(): void
        +create_session(): ClientSession
        +terminate_session(): void
        +start_episode(): Episode
        +step(): SessionStepResponse
        +get_current_task(): Dict[str, Any]
        +get_policy(): PolicyDocument
        +_get_session(): ClientSession
    }

    class SessionAPI {
        +session_manager: SessionManager
        +app: FastAPI
        +host: str
        +port: int
        --
        +start_server(): void
        +get_events_stream(): StreamingResponse
        --
        **REST API Endpoints**
        +POST /session
        +DELETE /session/{id}
        +POST /session/{id}/start-episode
        +POST /session/{id}/step
        +GET /session/{id}/current-task
        +GET /session/{id}/policy
        +GET /session/{id}/events
        +GET /health
        +GET /sessions
    }

    class ClientSession {
        +session_id: str
        +client_id: str
        +current_episode_id: str?
        +current_task_id: str?
        +created_at: datetime
        +last_activity: datetime
        +is_active: bool
        +context: Dict[str, Any]
        --
        +update_activity(): void
    }
}

package "Task Management" {

    class TaskManager {
        +domain: str
        +tasks: Dict[str, Task]
        +config_loader: TaskConfigLoader
        +episode_manager: EpisodeManager
        --
        +get_task(): Task
        +start_episode(): Episode
        +step(action, command_result?): Step
        +reset(): Episode
        +end_episode(): Episode
        +list_tasks(): List[Dict]
    }

    class Task {
        +task_id: str
        +title: str
        +subtasks: List[SubTask]
        --
        +get_all_subtask_ids(): Set[str]
    }

    class EpisodeManager {
        +active_episodes: Dict[str, Episode]
        --
        +start_episode(): Episode
        +step(): Step
        +end_episode(): Episode
        +get_current_episode(): Episode?
    }

    class Episode {
        +episode_id: str
        +task_id: str
        +session_id: str
        +state: EpisodeState
        +steps: List[Step]
        +completion_reason: str?
        --
        +add_step(): void
    }

    enum EpisodeState {
        CREATED
        ACTIVE
        COMPLETED
        FAILED
        TIMEOUT
        RESET
    }
}

package "Command Execution Framework" {

    class ExecutionManager {
        +_cli_command: DockerCLIExecutor
        +_security_validator: SecurityValidator
        +_sandbox_manager: SandboxManager
        --
        +step(action: Action): CommandResult
        +validate_command(): ValidationResult
        +get_security_info(): Dict[str, Any]
        +list_commands(): List[Dict[str, Any]]
    }

    class DockerCLIExecutor {
        +_sandbox_manager: SandboxManager
        --
        +execute(): CommandResult
        +validate_parameters(): ValidationResult
        +to_mcp_schema(): Dict[str, Any]
    }

    class SandboxManager {
        +active_sessions: Dict[str, DockerExecutionEnvironment]
        --
        +create_session_environment(): DockerExecutionEnvironment
        +cleanup_session(): void
        +cleanup_all_sessions(): void
    }
}

package "Policy and Evaluation" {

    class PolicyManager {
        +domain_policy: PolicyDocument
        --
        +get_policy(): PolicyDocument
        +validate_action(): bool
    }

    class PolicyDocument {
        +domain: str
        +available_commands: List[CommandDescription]
        +guidelines: str
        +constraints: List[str]
        --
        +to_mcp_resource(): MCPResource
    }

    class EvaluationManager {
        +trajectory_store: TrajectoryStore
        +action_tracker: ActionTracker
        --
        +log_action(): void
        +get_trajectory(): List[ActionRecord]
    }

    class ActionTracker {
        +session_actions: Dict[str, List[ActionRecord]]
        --
        +record_action(): void
        +get_session_actions(): List[ActionRecord]
    }

    class ActionRecord {
        +session_id: str
        +command_name: str
        +parameters: Dict[str, Any]
        +result: CommandResult
        +timestamp: datetime
        --
        +to_dict(): Dict[str, Any]
    }

    class TrajectoryStore {
        +storage_backend: StorageBackend
        --
        +save_trajectory(): void
        +load_trajectory(): List[ActionRecord]
    }
}

' Relationships
SessionManager *-- ClientSession
SessionManager *-- TaskManager
SessionManager *-- ExecutionManager
SessionManager *-- PolicyManager
SessionManager *-- EvaluationManager
SessionManager *-- SessionAPI

SessionAPI ..> SessionManager : delegates to

TaskManager *-- EpisodeManager
TaskManager *-- Task
Task ..> EpisodeState
EpisodeManager *-- Episode

ExecutionManager *-- DockerCLIExecutor
ExecutionManager *-- SandboxManager

PolicyManager *-- PolicyDocument
EvaluationManager *-- TrajectoryStore
EvaluationManager *-- ActionTracker
ActionTracker *-- ActionRecord

note top of SessionManager
**SABER Domain Server & Session Manager**
- Hosts one security domain (scalable to multiple instances)
- Manages multiple concurrent client sessions
- Single point of access for all client interactions
- Orchestrates task execution and command processing
- Handles server lifecycle (start/shutdown)
- Coordinates all server components
- Built for horizontal scaling with load balancing
- Provides REST API for command execution and task management
end note
note top of TaskManager
**Task Orchestrator**
Coordinates task loading and episode management.
Provides RL gym-style interfaces (step, reset).
Simplified to focus on coordination between components.
See task_framework_architecture.puml for detailed Task design.
end note

note left of Task
**Simplified Task Definition**
Tasks contain basic task information and subtasks for reference.
No progression logic, dependency validation, or state tracking.
Subtasks are purely informational elements returned at episode start.
See task_framework_architecture.puml for complete Task framework.
end note

note top of EpisodeManager
**Episode Manager**
Focuses on episode lifecycle management and step creation.
Returns Step objects directly from step() method.
Manages RL-compatible episode state transitions.
end note

note top of ExecutionManager
**Docker Sandbox Execution Manager**
Manages Docker-based command execution with security validation.
Coordinates between CLI executor and sandbox management.
Provides command listing for REST API.
See tool_execution_architecture.puml for complete Command design.
end note

@enduml
