package "SABER Server Side" {

    class ClientSession {
        +session_id: str
        +client_id: str
        +active_episode_ids: List[str]
        +episode_history: List[str]
        +task_queue: List[str]
        +created_at: datetime
        +last_activity: datetime
        +is_active: bool
        +context: Dict[str, Any]
        --
        +update_activity(): void
        +add_active_episode(episode_id: str): void
        +remove_active_episode(episode_id: str): void
        +complete_episode(episode_id: str): void
        +add_task_to_queue(task_id: str): void
        +get_next_task(): Optional[str]
        +has_active_episodes(): bool
        +get_episode_count(): Dict[str, int]
    }

    class SessionManager {
        +domain_name: str
        +config_dir: str
        +host: str = "0.0.0.0"
        +port: int = 8000
        +mcp_host: str = "0.0.0.0"
        +mcp_port: int = 3001
        +session_timeout_minutes: int = 30
        +cleanup_interval_minutes: int = 5
        +active_sessions: Dict[str, ClientSession]
        +benchmark_manager: BenchmarkManager
        +episode_manager: EpisodeManager
        +execution_manager: ExecutionManager
        +policy_manager: PolicyManager
        +evaluation_manager: EvaluationManager
        +evaluation_service: SessionEvaluationService
        +rest_api: SessionRestAPI
        +mcp_api: SessionMCPAPI
        +cleanup_task: Optional[asyncio.Task]
        +shutdown_event: asyncio.Event
        +manifest: Optional[Dict[str, Any]]
        +manifest_path: Optional[str]
        --
        +create_session(client_id: str): ClientSession
        +terminate_session(session_id: str): void
        +create_episode(session_id: str, task_id: str): EpisodeCreateResponse
        +end_episode(session_id: str, episode_id: str, reason: str): EpisodeEndResponse
        +get_benchmark_info(): BenchmarkInfo
        +get_task_info(session_id: str): TaskInfo
        +get_policy(session_id: str): PolicyResponse
        +get_evaluation_criteria(session_id: str, episode_id: str): EvaluationCriteriaResponse
        +get_health_metadata(): Dict[str, Any]
        +_cleanup_expired_sessions(): void
        +_check_permanent_environment_health(): Dict[str, Any]
    }

    class BenchmarkManager {
        +domain: str
        +config_dir: Path
        +tasks: Dict[str, Task]
        +benchmark_config: Dict[str, Any]
        +dependency_configs: Dict[str, DependencyConfig]
        --
        +get_task(task_id: str): Task
        +list_tasks(): List[Dict[str, Any]]
        +get_benchmark_config(): Dict[str, Any]
        +get_dependency_config(task_id: str): DependencyConfig
        +list_benchmark_tasks(): List[Dict[str, Any]]
        +_load_tasks(): void
        +_load_benchmark_config(): void
        +_load_dependency_configs(): void
    }

    class EpisodeManager {
        +active_episodes: Dict[str, Episode]
        +episode_dependencies: Dict[str, Set[str]]
        --
        +start_episode(session_id: str, task_id: str, task: Task): Episode
        +end_episode(session_id: str, episode_id: str, reason: EpisodeTerminationReason): Episode
        +get_episode(session_id: str, episode_id: str): Optional[Episode]
        +get_session_episodes(session_id: str): List[Episode]
        +list_active_episodes(): List[str]
        +cascade_terminate_dependent_episodes(episode_id: str): List[str]
        +_generate_episode_id(session_id: str, task_id: str): str
        +_create_episode_context(task: Task): EpisodeContext
    }

    class ExecutionManager {
        +config_dir: str
        +executor_factory: ExecutorFactory
        +sandbox_manager: SandboxEnvironmentManager
        +permanent_manager: Optional[PermanentEnvironmentManager]
        +environment_loader: EnvironmentLoader
        --
        +initialize_permanent_environment_manager(config: Dict): void
        +step(action: Action, headers: RequestHeaders): CommandResult
        +configure_for_task(session_id: str, episode_id: str, task: Task): void
        +cleanup_episode(session_id: str, episode_id: str): bool
        +cleanup_session(session_id: str): bool
        +cleanup_all_sessions(): bool
        +list_commands(): List[Dict[str, Any]]
        +get_security_info(): Dict[str, Any]
        +to_mcp_tools(): List[Dict[str, Any]]
        +health_check(): Dict[str, Any]
    }

    class PolicyManager {
        +domain_name: str
        +policy_document: PolicyDocument
        --
        +get_policy(): PolicyDocument
        +_load_policy(): PolicyDocument
    }

    class EvaluationManager {
        +store: EvaluationStore
        --
        +log_session_start(session_id: str, client_id: str): void
        +log_session_end(session_id: str): void
        +log_episode_start(session_id: str, episode_id: str, task_id: str): void
        +log_episode_end(session_id: str, episode_id: str, reason: str): void
        +log_action(session_id: str, episode_id: str, action: Action, result: CommandResult): void
    }

    class SessionEvaluationService {
        +store: EvaluationStore
        --
        +get_evaluation_criteria(session_id: str, episode_id: str): EvaluationCriteriaResponse
        +get_evaluation(session_id: str, episode_id: str): EvaluationResponse
        +list_evaluations(session_id: str, task_id: Optional[str]): EvaluationListResponse
        +get_evaluation_summary(session_id: str): EvaluationSummaryResponse
        +override_evaluation(session_id: str, episode_id: str, request: EvaluationOverrideRequest): EvaluationOverrideResponse
        +upload_evaluation_file(session_id: str, episode_id: str, file: UploadFile): EvaluationFileUploadResponse
    }

    class SessionRestAPI {
        +session_manager: SessionManager
        +host: str
        +port: int
        +app: FastAPI
        --
        +_setup_routes(): void
        +start_server(): void
    }

    class SessionMCPAPI {
        +session_manager: SessionManager
        +host: str
        +port: int
        +mcp_server: Optional[FastMCP]
        +tool_generator: MCPToolGenerator
        --
        +_get_headers(): RequestHeaders
        +_setup_mcp_handlers(): void
        +start_server(): void
    }
}

package "SABER Client Side - Inspect AI Integration" {

    class "Domain Task File" as DomainTask {
        --
        **Example: domains/cybench/cybench.py**
        +@task decorator
        +create_domain_task() factory
        --
        **Entry Point**
        +Discovered by inspect list tasks
        +Invoked by inspect eval
    }

    class create_domain_task {
        +domain_slug: str
        +domains_root: Path
        --
        **Task Factory**
        +Creates Inspect AI Task
        +Manages server lifecycle
        +Loads dataset
        +Configures sandbox
    }

    class SABERSandboxEnvironment {
        +domain: str
        +session_manager: ClientSessionManager
        +episode_id: Optional[str]
        --
        +setup(): SandboxEnvironmentSpec
        +exec(): ExecResult
        +__call__(): tuple
        --
        **Sandbox Lifecycle**
        +_start_domain_server()
        +_create_episode()
        +_cleanup_episode()
    }

    class create_saber_dataset {
        +session_manager: ClientSessionManager
        +task_filter: Optional[str]
        --
        **Dataset Factory**
        +Fetches tasks from server
        +Creates inspect_ai.Sample instances
    }

    class saber_scorer {
        +session_manager: ClientSessionManager
        --
        **Scorer Implementation**
        +Retrieves evaluation from server
        +Creates inspect_ai.Score
    }

    class ClientSessionManager {
        +config: SessionManagerConfig
        +rest_client: SABERRestClient
        +_current_session_id: Optional[str]
        --
        +create_session(): str
        +terminate_session(): bool
        +create_episode(): EpisodeCreateResponse
        +get_tasks(): List[TaskInfo]
        +get_policy_response(): PolicyResponse
        +submit_evaluation(): EvaluationResponse
    }

    class SABERRestClient {
        +base_url: str
        +timeout: float
        --
        +get_benchmark_info(): BenchmarkInfo
        +create_session(): SessionCreateResponse
        +create_episode(): EpisodeCreateResponse
        +get_evaluation(): EvaluationResponse
        +health_check(): Dict[str, Any]
    }

    class DomainController {
        +domain_slug: str
        +process: Optional[subprocess.Popen]
        --
        +start_server(): void
        +stop_server(): void
        +health_check(): bool
    }
}

' Server Internal Relationships
SessionManager *-- ClientSession : manages
SessionManager *-- BenchmarkManager
SessionManager *-- EpisodeManager
SessionManager *-- ExecutionManager
SessionManager *-- PolicyManager
SessionManager *-- EvaluationManager
SessionManager *-- SessionEvaluationService
SessionManager *-- SessionRestAPI
SessionManager *-- SessionMCPAPI
EvaluationManager *-- SessionEvaluationService : provides store

' Client Internal Relationships
DomainTask ..> create_domain_task : uses
create_domain_task *-- SABERSandboxEnvironment : creates
create_domain_task ..> create_saber_dataset : uses
create_domain_task ..> saber_scorer : uses
create_domain_task ..> DomainController : manages

SABERSandboxEnvironment *-- ClientSessionManager : uses
create_saber_dataset ..> ClientSessionManager : uses
saber_scorer ..> ClientSessionManager : uses

ClientSessionManager *-- SABERRestClient : uses
DomainController ..> SessionManager : launches/manages

' Client-Server Communication
ClientSessionManager ..> SessionRestAPI : "HTTP REST API calls"
SABERSandboxEnvironment ..> SessionMCPAPI : "MCP tool execution"
SABERRestClient ..> SessionRestAPI : "Direct HTTP calls"
DomainController ..> SessionManager : "Process management"

note top of SessionManager
**SABER Domain Server & Session Manager - Current Implementation**
- Central orchestrator hosting one security domain with async/await architecture
- Manages multiple concurrent client sessions with automatic timeout and cleanup via asyncio tasks
- Dual protocol support: SessionRestAPI (FastAPI) for session/episode management, SessionMCPAPI (FastMCP) for tool execution
- Integrates ExecutionManager for Docker sandbox command execution with security validation
- Supports multi-episode sessions with cascade termination for dependent episodes
- Health monitoring with manifest information and permanent environment checks
- Built for horizontal scaling with stateless design and proper async resource management
- Enhanced evaluation support with SessionEvaluationService for criteria retrieval and file uploads
end note

note top of ExecutionManager
**Command Execution Manager with Dual Environment Support - Current Implementation**
- Factory-based executor management supporting CLI, Python, and custom executors via registry
- Manages both Docker sandbox (ephemeral) and optional permanent environment containers
- Per-episode configuration and cleanup with proper resource lifecycle management
- Provides command listing, security information, and MCP tool schema generation
- Handles execution with security validation and resource management using async/await
- Environment loader supports flexible environment specifications (string refs, dict configs)
- Automatic network bridging between sandbox and permanent environments when configured
- Health checks and comprehensive error handling with fail-fast principles
end note

note left of create_domain_task
**Domain Task Factory - Inspect AI Integration**

Entry point for SABER evaluations via Inspect AI:
- Creates Inspect AI Task with SABER components
- Manages domain server lifecycle (start/stop)
- Loads dataset from SABER server via create_saber_dataset()
- Configures SABERSandboxEnvironment for tool execution
- Attaches saber_scorer for evaluation
- Supports task filtering and agent configuration

Used by domain task files (e.g., cybench.py, excytin.py)
to create discoverable Inspect AI tasks.

Command: inspect eval domains/<domain> --model <model>
end note

note top of ClientSessionManager
**SABER Client Session Manager - Current Implementation**

Manages HTTP session lifecycle with SABER server:
- Session creation and episode management via REST API
- Task and policy information retrieval
- Evaluation submission and retrieval
- MCP tool execution handled by Inspect AI's mcp_server_http()
- Fail-fast error handling with structured exceptions
- Async context manager for proper resource cleanup
- Used by SABERSandboxEnvironment, dataset, and scorer

No custom MCP client - Inspect AI handles MCP natively.
end note

note bottom of SABERSandboxEnvironment
**SABER Sandbox Environment - Inspect AI Bridge**

Implements Inspect AI SandboxEnvironment protocol:
- Manages SABER domain server lifecycle
- Creates and manages episodes per evaluation sample
- Provides MCP tool execution via Inspect AI
- Handles context injection for agent messages
- Automatic episode cleanup on sample completion
- Stores episode_id in Inspect AI's global store

This is the bridge between Inspect AI's agent framework
and SABER's security testing infrastructure.
end note

@enduml
