@startuml SABER System Overview

!theme plain
title Security Agent Benchmarking System - System Overview

skinparam class {
    BackgroundColor lightblue
    BorderColor black
    ArrowColor black
    FontSize 12
}

skinparam package {
    BackgroundColor lightyellow
    BorderColor black
    FontSize 14
}

skinparam note {
    BackgroundColor lightgreen
    FontSize 10
}

package "SABER Server Side" {

    class DomainServer {
        +domain_name: str
        +session_manager: SessionManager
        --
        +start_server(): void
        +handle_client_connection(): ClientSession
        +shutdown(): void
    }

    class SessionManager {
        +active_sessions: Dict[str, ClientSession]
        +task_manager: TaskManager
        +mcp_server: MCPServer
        +policy_manager: PolicyManager
        +evaluation_manager: EvaluationManager
        --
        +create_session(): ClientSession
        +execute_command(): CommandResult
        +get_current_task(): SubTask
        +get_policy(): PolicyDocument
    }

    class TaskManager {
        +domain: str
        +tasks: Dict[str, Task]
        +config_loader: TaskConfigLoader
        +episode_manager: EpisodeManager
        --
        +get_task(): Task
        +get_subtask(): SubTask
        +start_episode(): Episode
        +step(session_id, action, command_result?): Step
        +reset(): Episode
        +end_episode(): Episode
        +list_tasks(): List[Dict]
    }

    class MCPServer {
        +execution_manager: ExecutionManager
        --
        +execute_command(): CommandResult
        +list_commands(): List[Command]
        +handle_command_call(): CommandResult
        +to_mcp_commands(): List[Dict[str, Any]]
    }

    class ExecutionManager {
        +_configuration: ExecutionConfiguration
        +_cli_command: DockerCLIExecutor
        +_security_validator: SecurityValidator
        +_sandbox_manager: SandboxManager
        +_semaphore: Semaphore
        --
        +execute_command(): CommandResult
        +validate_command(): ValidationResult
        +to_mcp_commands(): List[Dict[str, Any]]
        +get_security_info(): Dict[str, Any]
        +get_execution_stats(): Dict[str, Any]
    }

    class ExecutionConfiguration {
        +_config: Dict[str, Any]
        --
        +get_execution_config(): Dict[str, Any]
        +get_security_config(): Dict[str, Any]
        +get_cli_config(): Dict[str, Any]
        +get_sandbox_config(): Dict[str, Any]
        +get_execution_timeout(): float
        +get_max_concurrent(): int
        +get_allowed_commands(): List[str]
    }

    class DockerCLIExecutor {
        +_security_command_metadata: Dict
        +_sandbox_manager: SandboxManager
        --
        +build_command(): List[str]
        +parse_output(): CommandResult
        +execute(): CommandResult
        +validate_parameters(): ValidationResult
        +to_mcp_schema(): Dict[str, Any]
        +get_security_info(): Dict[str, Any]
    }

    class SandboxManager {
        +sandbox_config: Dict[str, Any]
        +active_sessions: Dict[str, DockerExecutionEnvironment]
        --
        +create_session_environment(): DockerExecutionEnvironment
        +get_session_environment(): Optional[DockerExecutionEnvironment]
        +cleanup_session(): void
        +cleanup_all_sessions(): void
    }

    class SecurityValidator {
        +allowed_commands: Set[str]
        --
        +validate_command_string(): ValidationResult
        +validate_arguments(): ValidationResult
        +get_security_info(): Dict[str, Any]
    }

    class PolicyManager {
        +domain_policy: PolicyDocument
        --
        +get_policy(): PolicyDocument
        +validate_action(): bool
    }

    class EvaluationManager {
        +trajectory_store: TrajectoryStore
        +action_tracker: ActionTracker
        --
        +log_action(): void
        +get_trajectory(): List[ActionRecord]
    }
}

package "SABER Client Side" {

    class AgentClient {
        +client_id: str
        +domain: str
        +agent_under_test: AgentUnderTest
        +session_connection: SessionConnection
        --
        +connect_to_domain(): void
        +start_task(): TaskExecution
        +disconnect(): void
        +forward_to_agent(): Response
    }

    class AgentUnderTest {
        +agent_id: str
        +current_context: Dict[str, Any]
        +task_state: Dict[str, Any]
        --
        +initialize(task_context, policy, guidelines): void
        +analyze_situation(): TaskAnalysis
        +generate_next_command(): CommandRequest
        +process_command_result(result): void
        +is_task_complete(): bool
        +get_current_strategy(): str
    }
    class SessionConnection {
        +session_manager_url: str
        +sse_client: SSEClient
        +http_client: HTTPClient
        --
        +establish_session(): str
        +send_unified_request(): Response
        +get_current_task(): SubTask
        +execute_command(): CommandResult
        +forward_task_context(): void
        +forward_command_result(): void
    }
}

package "Communication Layer" {

    abstract class Message {
        +message_id: str
        +timestamp: datetime
        --
        +serialize(): str
    }

    class CommandCallRequest {
        +command_name: str
        +parameters: Dict[str, Any]
    }

    class ToolCallResponse {
        +success: bool
        +result: Any
        +error_message: str?
    }

    class TaskAssignment {
        +task_id: str
        +subtask_id: str
        +context: Dict[str, Any]
    }
}

' Server Internal Relationships
DomainServer *-- SessionManager
SessionManager *-- TaskManager
SessionManager *-- MCPServer
SessionManager *-- PolicyManager
SessionManager *-- EvaluationManager
MCPServer *-- ExecutionManager
ExecutionManager *-- ExecutionConfiguration
ExecutionManager *-- DockerCLIExecutor
ExecutionManager *-- SecurityValidator
ExecutionManager *-- SandboxManager

' Client Internal Relationships
AgentClient *-- AgentUnderTest
AgentClient *-- SessionConnection

' Communication Relationships
Message <|-- CommandCallRequest
Message <|-- ToolCallResponse
Message <|-- TaskAssignment

' Cross-boundary Communication
AgentClient ..> SessionManager : "HTTP/SSE API"
SessionConnection ..> DomainServer : "Real-time Communication"

note top of DomainServer
**Core Server Instance**
- Hosts one security domain
- Manages client sessions
- Coordinates all server components
end note

note top of SessionManager
**Unified Client Endpoint**
- Single point of access for clients
- Orchestrates task execution
- Manages command execution via MCPServer
- Enforces single-client constraint
end note

note top of MCPServer
**Docker Sandbox Tool Execution Layer**
- Contains Docker-based ExecutionManager
- All commands executed in isolated Docker containers
- Session-based container management via SandboxManager
- Security validation with Docker container isolation
- Provides MCP-compatible interface
- Built-in concurrency control and parameter validation
end note

note left of AgentUnderTest
**The Agent Being Benchmarked**
- Customer-provided AI agent implementation
- Configurable LLM provider (OpenAI, Anthropic, etc.)
- Domain-specific reasoning and planning
- Receives task context, policy, and guidelines
- Generates commands based on analysis
- Processes results and adapts strategy
- Isolated from server communication details
end note

note top of AgentClient
**Client Infrastructure Layer**
- Manages server communication
- Handles session lifecycle
- Forwards context to AgentUnderTest
- Executes commands on behalf of agent
- Provides clean interface separation
end note

note bottom of "Communication Layer"
**Real-time Protocol**
- HTTP REST for requests
- Server-Sent Events for updates
- Structured message types
- Session-based communication
end note

@enduml
