# SABER Server for AI Red Team Demo Domain
# Extends the generic SABER server base
FROM saber/server:latest

LABEL saber.domain="airt_demo"
LABEL saber.component="server"
LABEL saber.framework="dual-agent"

# Copy domain-specific configuration
COPY server/config/ /app/config/

# Copy domain-specific data directory (contains SQL files and other resources)
COPY server/data/ /app/data/

# Set domain-specific environment variables
ENV SABER_DOMAIN=airt_demo
ENV SABER_CONFIG_DIR=/app/config

# Set domain-specific command
CMD ["python", "-m", "saber.server", "--start", "--domain", "airt_demo"]
