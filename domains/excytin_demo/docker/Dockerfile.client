# Excytin Demo Client for SABER
# Extends the generic SABER client base with standardized pip installation
FROM saber/client:latest

# Configure Git to use Azure CLI with Entra ID authentication
# Azure CLI is already installed in the base image
RUN git config --global credential.https://dev.azure.com.useHttpPath true && \
    git config --global credential.https://dev.azure.com.helper "!f() { echo \"username=oauth2\"; echo \"password=\$(az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken -o tsv)\"; }; f"

# Set working directory for domain-specific client
WORKDIR /app/client

# All SABER and inspect-ai dependencies are already installed in the base image
# Domain-specific configuration and code will be mounted as volumes during runtime
