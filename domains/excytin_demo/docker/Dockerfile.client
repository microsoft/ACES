# Excytin Demo Client for SABER
# Extends the generic SABER client base
FROM saber/client:latest

# Install Azure CLI for ADO authentication
RUN curl -sL https://aka.ms/InstallAzureCLIDeb | bash

# Configure Git to use Azure CLI with Entra ID authentication
RUN git config --global credential.https://dev.azure.com.useHttpPath true && \
    git config --global credential.helper store

# Install Python dependencies using uv
WORKDIR /app/client
