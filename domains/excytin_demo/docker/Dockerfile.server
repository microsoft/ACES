# SABER Server for Excytin Demo Domain
FROM python:3.11-slim

# Install system dependencies for Docker-in-Docker and networking
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for Docker-in-Docker execution)
RUN curl -fsSL https://get.docker.com | sh

# Set working directory
WORKDIR /app

# Copy and install Python dependencies from repo root
COPY pyproject.toml ./
COPY README.md ./
RUN pip install -e .

# Copy SABER source code from repo root
COPY src ./src

# Copy domain data directory (contains SQL files and other resources)
COPY domains/excytin_demo/server/data ./data

# Create config directory
RUN mkdir -p /app/config

# Set Python path and logging level
ENV PYTHONPATH=/app/src
ENV SABER_LOG_LEVEL=DEBUG

# Expose ports
EXPOSE 8000 8001

# Run the SABER server with verbose logging
CMD ["python", "-m", "saber.server", "--start", "--domain", "excytin_demo", "--verbose"]
