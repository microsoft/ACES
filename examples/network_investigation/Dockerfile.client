# SABER Client Dockerfile - Network Investigation Agent
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install UV package manager
RUN pip install uv

# Create workspace directory
WORKDIR /workspace

# Create user for running the application
RUN useradd -m -u 1000 agentuser && \
    chown -R agentuser:agentuser /workspace

# Copy client source
COPY client/ /workspace/

# Install Python dependencies
RUN cd /workspace && uv sync

# Set proper permissions
RUN chmod +x /workspace/entrypoint.sh && \
    chown -R agentuser:agentuser /workspace

# Switch to non-root user
USER agentuser

# Set environment variables
ENV PYTHONPATH=/workspace/src
ENV SABER_SERVER_URL=http://saber-server:8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import sys; sys.path.insert(0, '/workspace/src'); import network_investigation_client; print('OK')" || exit 1

# Run the client
CMD ["/workspace/entrypoint.sh"]
