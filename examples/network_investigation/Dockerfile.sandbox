FROM ubuntu:latest

# Install network investigation tools
RUN apt-get update && \
    apt-get install -y \
    net-tools \
    iproute2 \
    file \
    binutils \
    python3 \
    procps \
    findutils \
    grep \
    coreutils \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN groupadd -r tooluser && useradd -r -g tooluser tooluser

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER tooluser:tooluser
