# SABER Server Dockerfile - Network Investigation Domain
FROM python:3.11-slim

# Install system dependencies for security tools and Docker
RUN apt-get update && apt-get install -y \
    curl \
    file \
    binutils \
    bsdmainutils \
    net-tools \
    procps \
    docker.io \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install UV package manager
RUN pip install uv

# Create workspace directory
WORKDIR /workspace

# Create user for running the application
RUN useradd -m -u 1000 saberuser && \
    groupmod -g 1001 docker && \
    usermod -aG docker saberuser && \
    chown -R saberuser:saberuser /workspace

# Copy server source and configuration
COPY server/ /workspace/

# Install Python dependencies
RUN cd /workspace && uv sync

# Set proper permissions
RUN chmod +x /workspace/entrypoint.sh && \
    chown -R saberuser:saberuser /workspace

# Switch to non-root user
USER saberuser

# Expose the server port
EXPOSE 8000

# Set environment variables
ENV PYTHONPATH=/workspace/src
ENV SABER_DOMAIN=network_investigation
ENV SABER_PORT=8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the server
CMD ["/workspace/entrypoint.sh"]
