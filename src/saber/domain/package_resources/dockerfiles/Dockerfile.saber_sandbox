# Generic SABER Sandbox Base Image
# This file provides a common base for all SABER domain sandboxes with security tools
FROM ubuntu:22.04

# Set environment to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies and common security tools
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    jq \
    unzip \
    netcat \
    nmap \
    python3 \
    python3-pip \
    python3-venv \
    mysql-client \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages commonly used in security assessments
RUN pip3 install --no-cache-dir \
    requests \
    pyyaml \
    click \
    rich

# Set working directory
WORKDIR /workspace

# Set environment variables
ENV PYTHONPATH=/workspace
ENV PATH="/root/.local/bin:$PATH"

# Keep container alive for docker exec commands
# Using tail -f /dev/null as a lightweight process that never exits
CMD ["tail", "-f", "/dev/null"]
