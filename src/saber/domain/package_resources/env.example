# SABER Domain Environment Configuration
# Copy this file to .env and customize for your domain

# === REQUIRED VARIABLES ===
# These MUST be set for the compose file to work

# Domain to launch (must match a directory in domains/)
DOMAIN=cybench

# Absolute path to the domains directory
DOMAINS_ROOT=/home/ms_test/repos/oss_saber/domains

# Docker images (generated by domain build process)
SERVER_IMAGE=saber/cybench/server:latest
CLIENT_IMAGE=saber/cybench/client:latest
# SANDBOX_IMAGE=saber/cybench/sandbox:latest  # Optional, defaults to SERVER_IMAGE

# === OPTIONAL VARIABLES (with defaults) ===

# Port configuration
REST_PORT=8000
MCP_PORT=8001

# Network configuration
# Networks are managed automatically by Docker
# Note: Sandbox networks are created dynamically per-episode

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# === COMPOSE PROFILES ===
# Control which services are started and their privilege level
# Multiple profiles can be specified: COMPOSE_PROFILES=server,client,docker-socket

# Basic profiles (choose services to run):
# - server: Start only the server
# - client: Start only the client
# - server,client: Start both server and client (typical)
#
# Note: Sandboxes are created dynamically per-episode by the server
# using challenge-specific compose files, not via profiles

# Privilege profiles (security-sensitive, require domain manifest approval):
# - docker-socket: Mount Docker socket for container management
# - privileged: Run containers with elevated privileges

# Examples:
# COMPOSE_PROFILES=server,client                    # Standard server+client
# COMPOSE_PROFILES=server,client,docker-socket      # With Docker socket access

COMPOSE_PROFILES=server,client

# === COMPOSE PROJECT ===
# Docker Compose project name (defaults to domain name if not set)
# COMPOSE_PROJECT_NAME=${DOMAIN}

# === ADVANCED OPTIONS ===

# Custom network names (optional overrides)
# NETWORK_NAME=${DOMAIN}-saber-network
# SANDBOX_NETWORK_NAME=${DOMAIN}-saber-sandbox-network

# Container resource limits (optional)
# SERVER_MEMORY_LIMIT=2g
# CLIENT_MEMORY_LIMIT=1g
# SERVER_CPU_LIMIT=2.0
# CLIENT_CPU_LIMIT=1.0

# Health check intervals (optional)
# HEALTH_CHECK_INTERVAL=30s
# HEALTH_CHECK_TIMEOUT=10s
# HEALTH_CHECK_RETRIES=3

# === SECURITY NOTES ===
#
# 1. docker-socket profile mounts /var/run/docker.sock into containers
#    - Only enable if the domain explicitly requires it in its manifest
#    - Provides root-equivalent access to the host system
#    - Should be used only in trusted, isolated environments
#
# 2. privileged profile runs containers with --privileged flag
#    - Removes most container security boundaries
#    - Only enable for domains that explicitly require it
#    - Never use in production or shared environments
#
# 3. Network isolation (NETWORK_ISOLATED=true):
#    - Prevents domain containers from accessing external networks
#    - Recommended for domains that should not have internet access
#    - May break domains that require external API calls
