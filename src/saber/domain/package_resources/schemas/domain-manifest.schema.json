{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saber.security/schemas/domain-manifest.schema.json",
  "title": "SABER Domain Manifest",
  "description": "Schema for SABER domain configuration manifests",
  "type": "object",
  "required": [
    "schemaVersion",
    "domain",
    "images",
    "ports",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the manifest schema"
    },
    "domain": {
      "type": "object",
      "required": ["slug", "name"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Domain identifier used in paths and container names"
        },
        "name": {
          "type": "string",
          "description": "Human-readable domain name"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the domain's purpose"
        },
        "version": {
          "type": "string",
          "description": "Domain version"
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "required": ["server"],
      "properties": {
        "server": {
          "type": "object",
          "required": ["tag", "dockerfile"],
          "properties": {
            "tag": {
              "type": "string",
              "description": "Docker image tag for the server"
            },
            "dockerfile": {
              "type": "string",
              "description": "Path to server Dockerfile relative to domain root"
            },
            "buildArgs": {
              "type": "object",
              "patternProperties": {
                "^[A-Z_][A-Z0-9_]*$": {
                  "type": "string"
                }
              },
              "description": "Build arguments for server image"
            },
            "labels": {
              "type": "object",
              "patternProperties": {
                "^[a-z0-9._-]+$": {
                  "type": "string"
                }
              },
              "description": "Docker labels for server image"
            }
          },
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "required": ["tag", "dockerfile"],
          "properties": {
            "tag": {
              "type": "string",
              "description": "Docker image tag for the client"
            },
            "dockerfile": {
              "type": "string",
              "description": "Path to client Dockerfile relative to domain root"
            },
            "buildArgs": {
              "type": "object",
              "patternProperties": {
                "^[A-Z_][A-Z0-9_]*$": {
                  "type": "string"
                }
              },
              "description": "Build arguments for client image"
            },
            "labels": {
              "type": "object",
              "patternProperties": {
                "^[a-z0-9._-]+$": {
                  "type": "string"
                }
              },
              "description": "Docker labels for client image"
            }
          },
          "additionalProperties": false
        },
        "sandbox": {
          "type": "object",
          "required": ["tag", "dockerfile"],
          "properties": {
            "tag": {
              "type": "string",
              "description": "Docker image tag for the sandbox"
            },
            "dockerfile": {
              "type": "string",
              "description": "Path to sandbox Dockerfile relative to domain root"
            },
            "buildArgs": {
              "type": "object",
              "patternProperties": {
                "^[A-Z_][A-Z0-9_]*$": {
                  "type": "string"
                }
              },
              "description": "Build arguments for sandbox image"
            },
            "labels": {
              "type": "object",
              "patternProperties": {
                "^[a-z0-9._-]+$": {
                  "type": "string"
                }
              },
              "description": "Docker labels for sandbox image"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "justification"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Profile name for compose"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of what the profile enables"
          },
          "justification": {
            "type": "string",
            "description": "Security justification for why this elevated access is needed"
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "Whether this profile is required for basic domain functionality"
          }
        },
        "additionalProperties": false
      },
      "description": "Docker compose profiles required by this domain"
    },
    "ports": {
      "type": "object",
      "required": ["rest", "mcp"],
      "properties": {
        "rest": {
          "type": "object",
          "required": ["container", "public"],
          "properties": {
            "container": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "description": "Port inside the container"
            },
            "host": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "description": "Port on the host (optional, auto-assigned if not specified)"
            },
            "public": {
              "type": "boolean",
              "description": "Whether this port should be exposed publicly"
            }
          },
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "required": ["container", "public"],
          "properties": {
            "container": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "description": "Port inside the container"
            },
            "host": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "description": "Port on the host (optional, auto-assigned if not specified)"
            },
            "public": {
              "type": "boolean",
              "description": "Whether this port should be exposed publicly"
            }
          },
          "additionalProperties": false
        },
        "debug": {
          "type": "object",
          "required": ["container", "public"],
          "properties": {
            "container": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "description": "Port inside the container"
            },
            "host": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "description": "Port on the host (optional, auto-assigned if not specified)"
            },
            "public": {
              "type": "boolean",
              "description": "Whether this port should be exposed publicly"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["container", "public"],
        "properties": {
          "container": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "host": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "public": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target", "readonly"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["bind", "volume", "tmpfs"],
            "description": "Type of volume mount"
          },
          "source": {
            "type": "string",
            "description": "Source path (for bind mounts) or volume name"
          },
          "target": {
            "type": "string",
            "description": "Target path inside container"
          },
          "readonly": {
            "type": "boolean",
            "description": "Whether the mount should be read-only"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of what this volume is for"
          }
        },
        "additionalProperties": false
      },
      "description": "Additional volume mounts required by this domain"
    },
    "capabilities": {
      "type": "object",
      "required": ["networking", "filesystem", "execution"],
      "properties": {
        "networking": {
          "type": "object",
          "properties": {
            "internet_access": {
              "type": "boolean",
              "default": false,
              "description": "Whether agents can access the internet"
            },
            "custom_networks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Custom Docker networks this domain creates"
            }
          },
          "additionalProperties": false
        },
        "filesystem": {
          "type": "object",
          "properties": {
            "host_access": {
              "type": "boolean",
              "default": false,
              "description": "Whether containers can access host filesystem"
            },
            "writable_paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Paths where containers can write data"
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "properties": {
            "docker_socket": {
              "type": "boolean",
              "default": false,
              "description": "Whether containers need Docker socket access"
            },
            "privileged": {
              "type": "boolean",
              "default": false,
              "description": "Whether containers need privileged mode"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security tools and capabilities available to agents"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu_limit": {
          "type": "string",
          "pattern": "^\\d*\\.?\\d+$",
          "description": "CPU limit (e.g., '2.0', '1.5')"
        },
        "memory_limit": {
          "type": "string",
          "pattern": "^\\d+[bkmgtBKMGT]?$",
          "description": "Memory limit (e.g., '512m', '2g')"
        },
        "storage_limit": {
          "type": "string",
          "pattern": "^\\d+[bkmgtBKMGT]?$",
          "description": "Storage limit for ephemeral data"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "maintainer": {
          "type": "string",
          "description": "Domain maintainer contact"
        },
        "documentation": {
          "type": "string",
          "format": "uri",
          "description": "Link to domain documentation"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "Source repository URL"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for categorizing this domain"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
